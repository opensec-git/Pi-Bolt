# Pins for the on-device engine pack. Sourced by build-pack.sh and the container scripts.
# Changing anything here changes packFingerprint, so the app rebuilds its symlink farm on update.

APP_ID=in.opensec.pibolt
PREFIX=/data/data/in.opensec.pibolt/files/usr

# Pi-Bolt engine: the stock linux-arm64 AOT release. sha256 from the release's SHA256SUMS (signed: SHA256SUMS.sshsig).
ENGINE_VERSION=1.1.7
ENGINE_URL=https://github.com/opensec-git/Pi-Bolt/releases/download/bolt-v1.1.7/pi-bolt-linux-arm64.tar.gz
ENGINE_SHA256=b6a0288664f2800b554286e2f41d441383d83bec357802fd2625ec24beede087

# glibc, rebuilt from termux-pacman's Android recipe (gpkg/glibc) for PREFIX.
GLIBC_VERSION=2.44
GLIBC_URL=https://ftp.gnu.org/gnu/libc/glibc-2.44.tar.xz
GLIBC_SHA256=37f600f2bef3c5e8300147059568b2a2e40a7ad6ccc65ce942556d49429cc667
TERMUX_GLIBC_REPO=https://github.com/termux-pacman/glibc-packages
TERMUX_GLIBC_COMMIT=3d99b6682f8c74ad82bda39315325189d8d34966

# Built from source for PREFIX (paths compiled in, OpenSSL TLS, CA bundle at PREFIX/etc/ssl/certs).
CURL_VERSION=8.23.0
CURL_URL=https://curl.se/download/curl-8.23.0.tar.xz
CURL_SHA256=8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5
GIT_VERSION=2.56.0
GIT_URL=https://www.kernel.org/pub/software/scm/git/git-2.56.0.tar.xz
GIT_SHA256=26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3

# Debian packages (bash, busybox, ripgrep, fd, shared libraries, CA certificates, terminfo): userland/debs.lock.
# Downloaded from deb.debian.org, falling back to snapshot.debian.org at the lock's @snapshot time; sha256 checked.
DEBIAN_MIRROR=https://deb.debian.org
DEBIAN_SNAPSHOT=https://snapshot.debian.org/archive

# Language runtimes (runtimes/build-runtimes.sh), shipped in the APK like the userland.
# Node.js LTS: the official linux-arm64 build; sha256 from the release's SHASUMS256.txt (signed by the Node.js releasers).
NODE_VERSION=22.23.4
NODE_URL=https://nodejs.org/dist/v22.23.4/node-v22.23.4-linux-arm64.tar.xz
NODE_SHA256=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
# CPython, built from source for PREFIX; sha256 as listed on python.org's release page.
PYTHON_VERSION=3.14.10
PYTHON_URL=https://www.python.org/ftp/python/3.14.10/Python-3.14.10.tar.xz
PYTHON_SHA256=de414a57119abef52784d8993e341d53aed635fc2b05c2607d9f98a2c5b72032
# esbuild (runtimes/build-esbuild.sh): built from the release's source (GitHub tag archive) with the Go release that
# esbuild's go.version names, plus runtimes/esbuild-host-versions.patch. sha256 of the Go archive as listed on go.dev/dl.
ESBUILD_VERSION=0.28.2
ESBUILD_URL=https://github.com/evanw/esbuild/archive/refs/tags/v0.28.2.tar.gz
ESBUILD_SHA256=300162f899361d9f0263065f8728ef9086dcfc1a3d36bcbc4e0abe5de9c58bf8
GO_VERSION=1.26.5
GO_URL=https://go.dev/dl/go1.26.5.linux-arm64.tar.gz
GO_SHA256=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
