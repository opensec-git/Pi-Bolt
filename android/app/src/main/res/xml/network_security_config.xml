<?xml version="1.0" encoding="utf-8"?>
<!-- LAN endpoints are plain ws:// to an address only known from the pairing code. Every byte on them is
     Noise-encrypted to the host key from that code, so cleartext transport is allowed. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
