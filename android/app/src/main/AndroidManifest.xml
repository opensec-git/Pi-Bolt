<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- The on-device engine: DNS servers of the default network for its resolv.conf, and a foreground service type
         for a local run (the agent works on the phone itself). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- In-app updates: the APK downloads in a dataSync foreground service; Android's installer installs it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- A run on this phone keeps the CPU awake with the screen off (SessionService, background/WakePolicy), and asks
         once to leave battery optimization (background/BackgroundSetup; the APK is sideloaded, not on Play). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Dictation and voice mode (Android's SpeechRecognizer); asked for on the first tap of the mic only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: the speech recognition service the mic uses. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The text-to-speech engine voice mode speaks replies with. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- OEM background settings (background/OemSetup): resolved before opening, else the app's details. -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
    </queries>

    <application
        android:name=".PiBoltApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiBolt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PiBolt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The phone camera opens pairing codes (pibolt://pair#...) in the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pibolt" android:host="pair" />
            </intent-filter>
            <!-- Package links (pibolt://install?source=npm:<name>) open the package's install confirmation; nothing
                 installs without the user's tap (ui/packages/PackageLinks). pi.dev pages are not an app link: Pi-Bolt
                 cannot verify pi.dev (no assetlinks.json there), so they open in the browser; sharing one to Pi-Bolt
                 offers Install package (the share filter below). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pibolt" android:host="install" />
            </intent-filter>
            <!-- Files, images and text shared from other apps: imported into a project or put in its composer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The diagram renderer's WebView (ui/diagram) sends no usage metrics to Google. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />


        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the user's coding agent on the device while it works on a prompt in the background" />
        </service>
        <!-- Buttons and inline replies of session notifications (Stop, an answer, a message). -->
        <receiver
            android:name=".background.SessionActionReceiver"
            android:exported="false" />
        <service
            android:name=".terminal.TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's interactive terminal shells (and the dev servers and builds they started) running in the background" />
        </service>
        <service
            android:name=".update.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The one FileProvider (a component class can be declared once: a second <provider> with the same class left
             the installer without its read grant, so in-app updates failed with "App not installed"): session exports and
             shared images under cache/exports, the verified update APK under cache/updates (read by Android's package
             installer), and shared diagrams under cache/diagrams. ManifestRulesTest keeps component classes unique. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports;${applicationId}.updates;${applicationId}.diagrams"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
