+    jit.load32(Address(argument2, OBJECT_OFFSETOF(Slot, offset)), freeGPR);
+    jit.and32(TrustedImm32(Slot::offsetMask), freeGPR);
+    jit.emitInitializeInlineStorage(result, freeGPR);
+    mutatorFence(jit, freeGPR);
+    returnValue(jit);
+    slowCases.link(&jit);
+    tailCall(jit, Entry::RawNewObject);
+}
+
+// (globalObject, values, count, cache). Free: rax, r10, r8, r9.
+void generateFrontEndNewObjectLiteral(CCallHelpers& jit)
+{
+    JumpList slowCases;
+    emitAllocateFromCache(jit, argument3, freeGPR, argument4, argument5, slowCases);
+    jit.load32(Address(argument3, OBJECT_OFFSETOF(Slot, offset)), freeGPR);
+    jit.and32(TrustedImm32(Slot::offsetMask), freeGPR);
+    emitFillAndReturnObject(jit, argument1, argument2, freeGPR, argument4);
+    slowCases.link(&jit);
+    tailCall(jit, Entry::RawNewObjectLiteral);
