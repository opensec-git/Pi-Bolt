+void loadEntry(CCallHelpers& jit, Entry entry, GPRReg into)
+{
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfRuntimeTable()), into);
+    jit.loadPtr(Address(into, static_cast<unsigned>(entry) * sizeof(void*)), into);
+}
+
+// The arguments are as they were on entry.
+void tailCall(CCallHelpers& jit, Entry operation)
+{
+    loadEntry(jit, operation, freeGPR);
+    jit.farJump(freeGPR, OperationPtrTag);
+}
+
+// After an object has been filled in, before anyone else gets to see it.
+void mutatorFence(CCallHelpers& jit, GPRReg scratch)
+{
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfVM()), scratch);
+    Jump notNeeded = jit.branchTest8(CCallHelpers::Zero, Address(scratch, VM::offsetOfHeapMutatorShouldBeFenced()));
+    jit.storeFence();
+    notNeeded.link(&jit);
+}
+
+// What an operation that did not throw returns. The value is in rax already.
+void returnValue(CCallHelpers& jit)
+{
+    jit.move(TrustedImm32(0), GPRInfo::returnValueGPR2);
+    jit.ret();
+}
+
+// A cell with its header, and nothing else, filled in: in `result`. header, allocator, scratch: three temporaries.
+void emitAllocateFromCache(CCallHelpers& jit, GPRReg cache, GPRReg header, GPRReg allocator, GPRReg scratch, JumpList& slowCases)
+{
+    jit.load32(Address(cache, OBJECT_OFFSETOF(Slot, structureID)), header);
+    slowCases.append(jit.branchTest32(CCallHelpers::Zero, header));
+    jit.loadPtr(Address(cache, sizeof(Slot) + OBJECT_OFFSETOF(Slot, pointer)), allocator);
+    jit.emitAllocateWithNonNullAllocator(result, JITAllocator::variable(), allocator, scratch, slowCases, CCallHelpers::SlowAllocationResult::UndefinedBehavior);
+    jit.load64(Address(cache, sizeof(Slot)), allocator); // There is nothing in its low half.
+    jit.or64(allocator, header);
+    jit.store64(header, Address(result, 0));
+}
+
+// result: an object with its header filled in. capacity: how many properties there is room for in it. Clobbers capacity and count.
+void emitFillAndReturnObject(CCallHelpers& jit, GPRReg values, GPRReg count, GPRReg capacity, GPRReg scratch)
+{
+    jit.storePtr(TrustedImmPtr(nullptr), Address(result, JSObject::butterflyOffset()));
+    // From the end: what there is room for and nothing to put in, and then the values.
+    auto clear = jit.label();
+    Jump cleared = jit.branch32(CCallHelpers::BelowOrEqual, capacity, count);
+    jit.sub32(TrustedImm32(1), capacity);
+    jit.store64(TrustedImm32(0), BaseIndex(result, capacity, CCallHelpers::TimesEight, JSObject::offsetOfInlineStorage()));
+    jit.jump().linkTo(clear, &jit);
+    cleared.link(&jit);
+    auto copy = jit.label();
+    jit.sub32(TrustedImm32(1), count);
+    jit.load64(BaseIndex(values, count, CCallHelpers::TimesEight), scratch);
+    jit.store64(scratch, BaseIndex(result, count, CCallHelpers::TimesEight, JSObject::offsetOfInlineStorage()));
+    jit.branchTest32(CCallHelpers::NonZero, count).linkTo(copy, &jit);
+    mutatorFence(jit, scratch);
+    returnValue(jit);
