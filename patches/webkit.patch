+void Graph::noteMethodsDefined()
+{
+    MethodsOfProgram* methods = methodsOfProgram();
+    const FunctionsOfProgram* functions = functionsOfProgram();
+    if (!methods || !functions)
+        return;
+    auto note = [&](UniquedStringImpl* name, Node* value) {
+        if (!name)
+            return;
+        UnlinkedFunctionExecutable* made = functionMadeBy(value);
+        uint32_t number = made ? functions->numberOf(made) : 0;
+        if (number)
+            methods->recordMethod(name, number);
+        else
+            methods->recordOtherStore(name);
+    };
+    for (BasicBlock* block : m_rpo) {
+        for (Node* node : block->nodes) {
+            if (node->kind != NodeKind::Bytecode)
+                continue;
+            switch (node->opcode) {
+            case op_put_by_id: {
+                auto bytecode = node->as<OpPutById>();
+                note(m_codeBlock->identifier(bytecode.m_property).impl(), node->use(bytecode.m_value));
+                break;
+            }
+            case op_new_object: {
+                // The stores of a literal are folded into the allocation (parseBytecode()): its uses hold their values, under
+                // NewObjectPlan::registerOf(the store's number).
+                if (!node->numberOfLiteralProperties)
+                    break;
+                auto stores = Graph::storesOfLiteral(m_codeBlock->instructions(), node->bytecodeIndex.offset());
+                for (unsigned i = 0; i < node->numberOfLiteralProperties && i < stores.size(); ++i) {
+                    VirtualRegister reg = NewObjectPlan::registerOf(i);
+                    for (auto& use : node->uses) {
+                        if (use.reg == reg)
+                            note(m_codeBlock->identifier(m_codeBlock->instructions().at(stores[i])->as<OpPutById>().m_property).impl(), use.node);
+                    }
+                }
+                break;
+            }
+            case op_create_this: {
+                // Likewise an instance's fields, stored by its constructor.
+                if (!node->numberOfLiteralProperties)
+                    break;
+                auto plan = NewObjectPlan::forCreateThis(m_codeBlock->instructions(), node->bytecodeIndex.offset());
+                for (unsigned i = 0; i < plan.properties.size(); ++i) {
+                    VirtualRegister reg = NewObjectPlan::registerOf(i);
+                    for (auto& use : node->uses) {
+                        if (use.reg == reg)
+                            note(m_codeBlock->identifier(plan.properties[i].identifier).impl(), use.node);
+                    }
+                }
+                break;
+            }
+            case op_define_data_property: {
+                auto bytecode = node->as<OpDefineDataProperty>();
+                note(constantNameOf(node->use(bytecode.m_property)), node->use(bytecode.m_value));
+                break;
+            }
+            case op_put_getter_by_id:
+                methods->recordOtherStore(m_codeBlock->identifier(node->as<OpPutGetterById>().m_property).impl());
+                break;
+            case op_put_setter_by_id:
