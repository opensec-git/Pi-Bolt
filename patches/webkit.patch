 // Options::preferUnsplitAOTLoops(). Of a graph whose loops have not been split.
+// A read of a closure or module variable that is written with nothing but what has fast paths (numbers, strings, booleans, arrays,
+// typed arrays), and that starts as undefined or the hole: in the fast copy of a loop it is taken for what is written (see
+// Node::typeOfVariableRead).
+static bool variableReadNarrowsUsefully(Graph& graph, Node* node)
+{
+    VariableSummaries* summaries = graph.variableSummaries();
+    if (!Options::useAOTVariableNarrowing() || !summaries || !(node->type & (TUndefined | TEmpty)))
+        return false;
+    Variable variable = graph.variableAccessedBy(node);
+    if (!variable)
+        return false;
+    Type written = summaries->readWritten(variable, node->graph->codeBlock()->identifier(node->as<OpGetFromScope>().m_var).impl(), VariableSummaries::nobody);
+    return !!typeOfVariableReadInFastCopy(node->type, written);
+}
