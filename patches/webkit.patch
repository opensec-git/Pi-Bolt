+#undef AOT_INSTALL_FRONT_END
+    // With no front end in front of an operation, its raw entry is the operation itself.
+    // (The stubs of this CPU probe the megamorphic cache themselves, so the property front ends would add nothing.)
+#define AOT_INSTALL_RAW(name) entries[static_cast<unsigned>(Entry::Raw##name)] = entries[static_cast<unsigned>(Entry::operationAOT##name)];
+    AOT_INSTALL_RAW(GetById)
+    AOT_INSTALL_RAW(GetByVal)
+    AOT_INSTALL_RAW(PutById)
+    AOT_INSTALL_RAW(PutByVal)
+    AOT_INSTALL_RAW(InById)
+#undef AOT_INSTALL_RAW
+    // The helpers, in front of their operations (generateAheadOf() in AOTStubsX86_64.cpp), as on ARM64.
+#define AOT_INSTALL_HELPER(name, operation) install(Entry::operation, Entry::Behind##name, Stub::AheadOf##name);
+    FOR_EACH_AOT_OPERATION_BEHIND_HELPER(AOT_INSTALL_HELPER)
+#undef AOT_INSTALL_HELPER
+}
+
 #else
 
-void installOperationFrontEnds(VM&, void**) { }
+void installOperationFrontEnds(VM& vm, void** entries)
+{
+    entries[static_cast<unsigned>(Entry::MegamorphicCache)] = &vm.ensureMegamorphicCache();
