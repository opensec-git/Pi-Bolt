+// Every code unit that a match can start with, as sorted, merged ranges; nullopt if that is not known. Unlike
+// FirstCharacterBitmapBuilder this covers all code units and steps over lookarounds, which consume nothing. It only answers for
+// patterns that are neither unicode (a code point is not a code unit there) nor case-insensitive.
+class FirstCodeUnitRangesBuilder {
+public:
+    std::optional<Vector<CharacterRange>> build(PatternDisjunction* body)
+    {
+        addDisjunction(body, 0);
+        if (m_gaveUp)
+            return std::nullopt;
+        std::ranges::sort(m_ranges, { }, &CharacterRange::begin);
+        Vector<CharacterRange> merged;
+        for (auto& range : m_ranges) {
+            if (!merged.isEmpty() && range.begin <= merged.last().end + 1)
+                merged.last().end = std::max(merged.last().end, range.end);
+            else
+                merged.append(range);
+        }
+        return merged;
+    }
+
+private:
+    void addCharacterClass(const CharacterClass* cc)
+    {
+        if (cc->m_anyCharacter || !cc->m_strings.isEmpty()) {
+            m_gaveUp = true;
+            return;
+        }
+        for (char32_t c : cc->m_matches8)
+            m_ranges.append({ c, c });
+        for (auto& range : cc->m_ranges8)
+            m_ranges.append(range);
+        for (char32_t c : cc->m_matches32)
+            m_ranges.append({ c, c });
+        for (auto& range : cc->m_ranges32)
+            m_ranges.append(range);
+    }
+
+    // Whether the term surely consumes a character, which then is the first one: the terms after it need not be looked at.
+    bool addTerm(const PatternTerm& term, unsigned depth)
+    {
+        using Type = PatternTerm::Type;
+        switch (term.type) {
+        case Type::AssertionBOL:
+        case Type::AssertionEOL:
+        case Type::AssertionWordBoundary:
+        case Type::ParentheticalAssertion:
+            return false;
+        default:
+            break;
+        }
+        if (term.m_matchDirection == Backward) {
+            m_gaveUp = true;
+            return false;
+        }
+        switch (term.type) {
+        case Type::PatternCharacter:
+            m_ranges.append({ term.patternCharacter, term.patternCharacter });
+            return term.quantityMinCount > 0;
+        case Type::CharacterClass:
+            if (term.invert()) {
+                m_gaveUp = true;
+                return false;
+            }
+            addCharacterClass(term.characterClass);
+            return term.quantityMinCount > 0;
+        case Type::ParenthesesSubpattern:
+            if (depth > 8) {
+                m_gaveUp = true;
+                return false;
+            }
+            addDisjunction(term.parentheses.disjunction, depth + 1);
+            return term.quantityMinCount > 0 && term.parentheses.disjunction->m_minimumSize >= 1;
+        default:
+            m_gaveUp = true;
+            return false;
+        }
+    }
+
+    void addDisjunction(PatternDisjunction* disjunction, unsigned depth)
+    {
+        for (auto& alternative : disjunction->m_alternatives) {
+            bool consumes = false;
+            for (auto& term : alternative->m_terms) {
+                // See FirstCharacterBitmapBuilder::addAlternative(): what is left of a deleted leading `.*`.
+                if (term.type == PatternTerm::Type::DotStarEnclosure) {
+                    m_gaveUp = true;
+                    return;
+                }
+                if (consumes)
+                    continue;
+                consumes = addTerm(term, depth);
+                if (m_gaveUp)
+                    return;
+            }
+            // A top-level alternative that matches without consuming anything matches the empty string anywhere.
+            if (!depth && !consumes) {
+                m_gaveUp = true;
+                return;
+            }
+        }
+    }
+
+    Vector<CharacterRange> m_ranges;
+    bool m_gaveUp { false };
+};
+
+std::optional<Vector<CharacterRange>> computeFirstCodeUnitRanges(YarrPattern& pattern)
+{
+    if (!pattern.m_body || pattern.eitherUnicode() || pattern.ignoreCase() || pattern.m_containsModifiers || pattern.m_containsBackreferences)
+        return std::nullopt;
+    return FirstCodeUnitRangesBuilder().build(pattern.m_body);
