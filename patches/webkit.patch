+    int64_t delta = static_cast<int64_t>(target) - static_cast<int64_t>(at + length);
+    RELEASE_ASSERT(delta >= std::numeric_limits<int32_t>::min() && delta <= std::numeric_limits<int32_t>::max());
+    int32_t displacement = static_cast<int32_t>(delta);
+    memcpy(code.data() + at + 3, &displacement, sizeof(displacement));
+}
