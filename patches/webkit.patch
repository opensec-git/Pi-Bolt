+ALWAYS_INLINE std::optional<unsigned> RegExp::firstPossibleStart(StringView s, unsigned startOffset) const
+{
+    ASSERT(m_numberOfFirstCodeUnitRanges);
+    // The ranges are sorted: if the first does not reach into Latin-1, none does.
+    if (s.is8Bit()) {
+        if (m_firstCodeUnitsBegin[0] > 0xff)
+            return std::nullopt;
+        return startOffset;
+    }
+    auto characters = s.span16().subspan(startOffset);
+    using UnsignedType = uint16_t;
+    auto begin0 = SIMD::splat<UnsignedType>(m_firstCodeUnitsBegin[0]);
+    auto width0 = SIMD::splat<UnsignedType>(m_firstCodeUnitsEnd[0] - m_firstCodeUnitsBegin[0]);
+    char16_t first1 = m_firstCodeUnitsBegin[m_numberOfFirstCodeUnitRanges - 1];
+    char16_t last1 = m_firstCodeUnitsEnd[m_numberOfFirstCodeUnitRanges - 1];
+    auto begin1 = SIMD::splat<UnsignedType>(first1);
+    auto width1 = SIMD::splat<UnsignedType>(last1 - first1);
+    auto vectorMatch = [&](auto value) ALWAYS_INLINE_LAMBDA {
+        // An unsigned c - begin <= end - begin is begin <= c <= end.
+        auto in0 = SIMD::lessThanOrEqual(SIMD::sub(value, begin0), width0);
+        auto in1 = SIMD::lessThanOrEqual(SIMD::sub(value, begin1), width1);
+        return SIMD::findFirstNonZeroIndex(SIMD::bitOr2(in0, in1));
+    };
+    auto scalarMatch = [&](char16_t c) ALWAYS_INLINE_LAMBDA {
+        return static_cast<char16_t>(c - m_firstCodeUnitsBegin[0]) <= static_cast<char16_t>(m_firstCodeUnitsEnd[0] - m_firstCodeUnitsBegin[0])
+            || static_cast<char16_t>(c - first1) <= static_cast<char16_t>(last1 - first1);
+    };
+    const char16_t* found = SIMD::find(characters, vectorMatch, scalarMatch);
+    if (found == std::to_address(characters.end()))
+        return std::nullopt;
+    return startOffset + static_cast<unsigned>(found - characters.data());
+}
