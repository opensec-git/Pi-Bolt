+// TODO(x86-aot-port): the stubs that are not ported yet say which they are and stop. A stub leaves this list when it is.
+// (SYSV_ABI: the stub passes `stub` where the engine's own calls pass a first argument, which on Windows is not where C does.)
+static void NO_RETURN_DUE_TO_CRASH SYSV_ABI reportUnportedStub(unsigned stub)
+{
+    static constexpr ASCIILiteral names[] = {
+#define AOT_STUB_NAME(name) #name ""_s,
+        FOR_EACH_AOT_STUB(AOT_STUB_NAME)
+#undef AOT_STUB_NAME
+    };
+    dataLogLn("AOT: stub ", names[stub], " is not ported to x86-64 yet");
+    CRASH();
+}
+
+static void generateUnported(CCallHelpers& jit, Stub stub)
+{
+    jit.move(TrustedImm32(static_cast<unsigned>(stub)), A0);
+#if OS(WINDOWS)
+    // (The code of an image has no addresses in it on Windows, where it is not at a fixed one: the stub stops with its number in
+    // A0, for a debugger or a crash dump to show, rather than calling reportUnportedStub().)
+    UNUSED_PARAM(reportUnportedStub);
+#else
+    jit.move(CCallHelpers::TrustedImmPtr(tagCFunction<OperationPtrTag>(reportUnportedStub)), scratchGPR);
+    jit.andPtr(TrustedImm32(-static_cast<int32_t>(stackAlignmentBytes())), CCallHelpers::stackPointerRegister);
+    jit.call(scratchGPR, OperationPtrTag);
+#endif
+    jit.breakpoint();
+}
