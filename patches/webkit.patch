+    jit.storePtr(argument1, Address(result, JSCallee::offsetOfScopeChain()));
+    jit.loadPtr(Address(argument5, OBJECT_OFFSETOF(Slot, pointer)), freeGPR);
+    jit.storePtr(freeGPR, Address(result, JSFunction::offsetOfExecutableOrRareData()));
+    mutatorFence(jit, freeGPR);
+    jit.pop(borrowed);
+    returnValue(jit);
+    slowCases.link(&jit);
+    jit.pop(borrowed);
+    tailCall(jit, Entry::RawNewFunction);
