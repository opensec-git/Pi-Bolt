+// this turns into lea reg, [rip + disp32] for a target at offset `target` of the same buffer (or of whatever the code is copied into).
+inline void writeRIPRelativeLea(std::span<uint8_t> code, size_t at, size_t target)
+{
+    constexpr size_t length = 7;
+    RELEASE_ASSERT(at + length <= code.size() && (code[at] & 0xf0) == 0x40 && code[at + 1] == 0x8d && (code[at + 2] & 0xc7) == 0x85);
