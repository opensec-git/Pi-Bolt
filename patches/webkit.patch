+    FOR_EACH_AOT_OPERATION_WITH_FRONT_END(AOT_INSTALL_RAW)
+#undef AOT_INSTALL_RAW
+#define AOT_INSTALL_BEHIND(name, operation) entries[static_cast<unsigned>(Entry::Behind##name)] = entries[static_cast<unsigned>(Entry::operation)];
+    FOR_EACH_AOT_OPERATION_BEHIND_HELPER(AOT_INSTALL_BEHIND)
