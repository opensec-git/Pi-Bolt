+// The intrinsics that generateCallIntrinsic() handles on x86-64: all of ARM64's.
+static bool isIntrinsicOnX86(StubIntrinsic intrinsic)
+{
+    switch (intrinsic) {
+    case StubIntrinsic::CharCodeAt:
+    case StubIntrinsic::CodePointAt:
+    case StubIntrinsic::CharAt:
+    case StubIntrinsic::Push:
+    case StubIntrinsic::Pop:
+    case StubIntrinsic::IsArray:
+    case StubIntrinsic::Get:
+    case StubIntrinsic::Has:
+    case StubIntrinsic::Set:
+    case StubIntrinsic::SetIgnoringResult:
+    case StubIntrinsic::Add:
+    case StubIntrinsic::AddIgnoringResult:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static unsigned argumentCountOf(StubIntrinsic intrinsic)
+{
+    switch (intrinsic) {
+#define AOT_STUB_INTRINSIC_ARGUMENTS(name, text, argumentCount, result) \
+    case StubIntrinsic::name: \
+        return argumentCount;
+    FOR_EACH_AOT_STUB_INTRINSIC(AOT_STUB_INTRINSIC_ARGUMENTS)
+#undef AOT_STUB_INTRINSIC_ARGUMENTS
+    default:
+        RELEASE_ASSERT_NOT_REACHED();
+        return 0;
+    }
+}
+
+// As ARM64's findInMapOrSet(), with what registers x86-64 has. `map` = a JSMap or JSSet (thisGPR), `key` = A0; both, A1 (a Set's
+// value) and calleeGPR are only read. Finds the entry of the key and leaves its index in `index` (rdx: the entry's key is at
+// data[index], its value at data[index + 1], `data` = rcx), or jumps to `notThere`. Jumps to `otherwise` for a key, or a key it
+// collides with, of a kind this code does not handle. Uses the tag registers as temporaries, and so checks types without them from
+// the hash on: whoever continues from any exit puts them back (restoreTagRegisters()).
+template<typename MapOrSet>
+static void findInMapOrSetOnX86(CCallHelpers& jit, CCallHelpers::JumpList& otherwise, CCallHelpers::JumpList& notThere)
+{
+    using Helper = typename MapOrSet::Helper;
+    constexpr GPRReg map = thisGPR;
+    constexpr GPRReg key = A0;
+    constexpr GPRReg data = A3; // rcx
+    constexpr GPRReg index = A2; // rdx
+    constexpr GPRReg entryKey = A4; // r8
+    constexpr GPRReg hash = A5; // r9
+    constexpr GPRReg keyImpl = T9; // r10
+    constexpr GPRReg entryImpl = T11; // rbx
+    constexpr GPRReg scratch = T12; // r14, a tag register
+    constexpr GPRReg scratch2 = T13; // r15, a tag register
+    static_assert(noOverlap(map, key, A1, calleeGPR, data, index, entryKey, hash, keyImpl, entryImpl, scratch, scratch2, scratchGPR));
+
+    // The hash, if the key is normalized: a number that is not an int32 may not be, and a BigInt is hashed by value. (The tags are
+    // still good here.)
+    CCallHelpers::JumpList hashed;
+    CCallHelpers::JumpList plain;
+    Jump notCell = jit.branchIfNotCell(key);
+    Jump isString = jit.branchIfType(key, StringType);
+    otherwise.append(jit.branchIfType(key, HeapBigIntType));
+    plain.append(jit.jump());
+    isString.link(&jit);
+    jit.loadPtr(Address(key, JSString::offsetOfValue()), keyImpl);
+    otherwise.append(jit.branchTestPtr(CCallHelpers::NonZero, keyImpl, TrustedImm32(JSString::isRopeInPointer)));
+    jit.load32(Address(keyImpl, StringImpl::flagsOffset()), hash);
+    jit.urshift32(TrustedImm32(StringImpl::s_flagCount), hash);
+    otherwise.append(jit.branchTest32(CCallHelpers::Zero, hash));
+    hashed.append(jit.jump());
+    notCell.link(&jit);
+    Jump notNumber = jit.branchIfNotNumber(key);
+    otherwise.append(jit.branchIfNotInt32(key));
+    notNumber.link(&jit);
+    plain.link(&jit);
+    jit.move(key, hash);
+    // (mulq: rax and rdx are saved in the two scratches and put back, and the macro scratch register is used too.)
+    jit.rapidHashMix64(hash, scratch, scratch2);
+    hashed.link(&jit);
+
+    jit.loadPtr(Address(map, MapOrSet::offsetOfStorage()), data);
+    notThere.append(jit.branchTestPtr(CCallHelpers::Zero, data));
+    jit.addPtr(TrustedImm32(JSCellButterfly::offsetOfData()), data);
+    jit.load32(Address(data, Helper::capacityIndex() * sizeof(uint64_t)), index);
+    jit.sub32(TrustedImm32(1), index);
+    jit.and32(hash, index);
+    jit.add32(TrustedImm32(Helper::hashTableStartIndex()), index);
+    jit.load64(CCallHelpers::BaseIndex(data, index, CCallHelpers::TimesEight), index);
+
+    CCallHelpers::Label loop = jit.label();
+    CCallHelpers::JumpList found;
+    CCallHelpers::JumpList next;
+    notThere.append(jit.branchTest64(CCallHelpers::Zero, index));
+    jit.zeroExtend32ToWord(index, index);
+    jit.load64(CCallHelpers::BaseIndex(data, index, CCallHelpers::TimesEight), entryKey);
+    // The deleted-entry marker, in the macro scratch register just long enough to compare with it.
+    jit.loadPtr(Address(instanceGPR, Instance::offsetOfVM()), scratchGPR);
+    jit.load64(Address(scratchGPR, VM::offsetOfOrderedHashTableDeletedValue()), scratchGPR);
+    next.append(jit.branch64(CCallHelpers::Equal, entryKey, scratchGPR));
+    found.append(jit.branch64(CCallHelpers::Equal, entryKey, key));
+    // Both keys are normalized. If they are not identical, they are the same key only if both are strings with equal contents.
+    next.append(jit.branchIfNotCell(entryKey, DoNotHaveTagRegisters));
+    next.append(jit.branchIfNotCell(key, DoNotHaveTagRegisters));
+    next.append(jit.branchIfNotType(entryKey, StringType));
+    next.append(jit.branchIfNotType(key, StringType));
+    jit.loadPtr(Address(entryKey, JSString::offsetOfValue()), entryImpl);
+    otherwise.append(jit.branchTestPtr(CCallHelpers::NonZero, entryImpl, TrustedImm32(JSString::isRopeInPointer)));
+    found.append(jit.branchPtr(CCallHelpers::Equal, entryImpl, keyImpl));
+    jit.load32(Address(entryImpl, StringImpl::flagsOffset()), scratch);
+    jit.urshift32(scratch, TrustedImm32(StringImpl::s_flagCount), scratch2);
+    otherwise.append(jit.branchTest32(CCallHelpers::Zero, scratch2));
+    next.append(jit.branch32(CCallHelpers::NotEqual, scratch2, hash));
+    jit.load32(Address(entryImpl, StringImpl::lengthMemoryOffset()), scratch2);
+    next.append(jit.branch32(CCallHelpers::NotEqual, scratch2, Address(keyImpl, StringImpl::lengthMemoryOffset())));
+    // Same hash and same length. Compare the characters, if both strings are 8-bit. The index is set aside for that: there is no
+    // other register.
+    otherwise.append(jit.branchTest32(CCallHelpers::Zero, scratch, TrustedImm32(StringImpl::flagIs8Bit())));
+    otherwise.append(jit.branchTest32(CCallHelpers::Zero, Address(keyImpl, StringImpl::flagsOffset()), TrustedImm32(StringImpl::flagIs8Bit())));
+    jit.push(index);
+    jit.move(scratch2, index); // The length, counted down.
+    jit.loadPtr(Address(entryImpl, StringImpl::dataOffset()), entryImpl);
+    jit.loadPtr(Address(keyImpl, StringImpl::dataOffset()), scratch);
+    CCallHelpers::Label compare = jit.label();
+    Jump same = jit.branchTest32(CCallHelpers::Zero, index);
+    jit.sub32(TrustedImm32(1), index);
+    jit.load8(CCallHelpers::BaseIndex(entryImpl, index, CCallHelpers::TimesOne), scratch2);
+    jit.load8(CCallHelpers::BaseIndex(scratch, index, CCallHelpers::TimesOne), scratchGPR);
+    jit.branch32(CCallHelpers::Equal, scratch2, scratchGPR).linkTo(compare, &jit);
+    jit.pop(index);
+    next.append(jit.jump());
+    same.link(&jit);
+    jit.pop(index);
+    found.append(jit.jump());
+
+    next.link(&jit);
+    jit.load64(CCallHelpers::BaseIndex(data, index, CCallHelpers::TimesEight, Helper::ChainOffset * sizeof(EncodedJSValue)), index);
+    jit.jump().linkTo(loop, &jit);
+
+    found.link(&jit);
+}
+
+// As ARM64's: a call of a built-in function that the code does itself if the callee is that function and the case is simple.
+// Entered like Stub::Call (calleeGPR = the callee, thisGPR = `this`, the arguments in A0...), with T9 = the StubIntrinsic, since
+// there are no thunks here. Only T9, T11, A3-A5 are clobbered before the code knows it can do the call itself, so every other case
+// goes on to Stub::Call as it was entered, with T9 = the argument count. The tags are valid throughout, except within the Map and
+// Set cases, which put them back on every way out.
+static void generateCallIntrinsic(CCallHelpers& jit)
+{
+    CCallHelpers::Label call = s_labels[static_cast<unsigned>(Stub::Call)];
+    RELEASE_ASSERT(call.isSet());
+    constexpr GPRReg string = A3;
+    constexpr GPRReg index = A4;
+    constexpr GPRReg character = A5;
+    constexpr GPRReg temp = T11;
+    // As a call's: the code calls this the way it calls a function (Lowering::finishCall()). Not A0, as other stubs return.
+    constexpr GPRReg result = GPRInfo::returnValueGPR;
+
+    // Clobbers T9 and T11.
+    auto checkCallee = [&](CCallHelpers::JumpList& otherwise, Entry function) {
+        otherwise.append(jit.branchIfNotCell(calleeGPR));
+        otherwise.append(jit.branchIfNotType(calleeGPR, JSFunctionType));
+        jit.loadPtr(Address(calleeGPR, JSFunction::offsetOfExecutableOrRareData()), T11);
+        Jump hasExecutable = jit.branchTestPtr(CCallHelpers::Zero, T11, TrustedImm32(JSFunction::rareDataTag));
+        jit.loadPtr(Address(T11, FunctionRareData::offsetOfExecutable() - JSFunction::rareDataTag), T11);
+        hasExecutable.link(&jit);
