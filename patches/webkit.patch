+// What the caller has saved is put back, but not what a call through the stubs overwrites anyway: on x86-64, calleeGPR and stubT11GPR
+// are callee-saved by the C convention, and what leaves may be passing a value in them (the callee of a tail call).
+static void restoreCalleeSaves(CCallHelpers& jit, B3::Air::Code& code)
+{
+#if CPU(X86_64)
+    RegisterSet overwritten = stubClobberedRegisters();
+    for (const RegisterAtOffset& entry : code.calleeSaveRegisterAtOffsetList()) {
+        if (overwritten.contains(entry.reg(), IgnoreVectors))
+            continue;
+        RELEASE_ASSERT(entry.reg().isGPR());
+        jit.load64(CCallHelpers::Address(GPRInfo::callFrameRegister, entry.offset()), entry.reg().gpr());
+    }
+#else
+    jit.emitRestore(code.calleeSaveRegisterAtOffsetList());
+#endif
+}
+
+// And they are not saved on the way in either, since nothing puts them back: every caller of compiled code takes a call to clobber
+// them (stubClobberedRegisters(), Lowering::finishCall()), and whoever comes in from C, which expects them preserved, saves them in a
+// frame of its own (the adapters, adapt(); the AheadOf stubs). B3 still allocates them as callee-saved registers, which is what lets a
+// value stay in them across a call to a light stub (stubClobberedRegistersLight()).
+static void saveCalleeSaves(CCallHelpers& jit, B3::Air::Code& code)
+{
+#if CPU(X86_64)
+    RegisterSet overwritten = stubClobberedRegisters();
+    for (const RegisterAtOffset& entry : code.calleeSaveRegisterAtOffsetList()) {
+        if (overwritten.contains(entry.reg(), IgnoreVectors))
+            continue;
+        RELEASE_ASSERT(entry.reg().isGPR());
+        jit.store64(entry.reg().gpr(), CCallHelpers::Address(GPRInfo::callFrameRegister, entry.offset()));
+    }
+#else
+    jit.emitSave(code.calleeSaveRegisterAtOffsetList());
+#endif
+}
