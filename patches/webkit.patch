-        )
+        if (WIN32)
+            # A symbolic link needs a privilege on Windows (or Developer Mode), and clang does not take a hard link or a copy for
+            # the same file as far as #pragma once goes. A forwarding header does: it includes the source by its own path, so
+            # every way of reaching the header reaches that one file. Written now (it says the same whatever the source
+            # becomes); whatever else is there first is removed, not written through: it may be a link to the source.
+            set(_forward "#pragma once\n#include \"${src_file}\"\n")
+            set(_existing "")
+            if (EXISTS "${dst_file}")
+                file(READ "${dst_file}" _existing)
+            endif ()
+            if (NOT _existing STREQUAL _forward)
+                file(REMOVE "${dst_file}")
+                get_filename_component(_dst_dir "${dst_file}" DIRECTORY)
+                file(MAKE_DIRECTORY "${_dst_dir}")
+                file(WRITE "${dst_file}" "${_forward}")
+            endif ()
+        else ()
+            add_custom_command(OUTPUT ${dst_file}
+                COMMAND ${CMAKE_COMMAND} -E create_symlink ${src_file} ${dst_file}
+                MAIN_DEPENDENCY ${src_file}
+                VERBATIM
+            )
+        endif ()
         list(APPEND dst_files ${dst_file})
     endforeach ()
     add_custom_target(${target_name} ALL DEPENDS ${dst_files})
