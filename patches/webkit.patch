+static void recordRegExpForImage(const String& pattern, OptionSet<Yarr::Flags> flags)
+{
+    static Lock lock;
+    static NeverDestroyed<UncheckedKeyHashSet<String>> recorded;
+    StringBuilder line;
+    line.append(String::fromLatin1(Yarr::flagsString(flags).data()), '/');
+    for (char16_t c : StringView(pattern).codeUnits()) {
+        if (c == '\\')
+            line.append("\\\\"_s);
+        else if (c == '\n')
+            line.append("\\n"_s);
+        else if (c == '\r')
+            line.append("\\r"_s);
+        else if (c < 0x20 || c >= 0x7f) {
+            // As code units, so that a lone surrogate comes back as itself (UTF-8 could not carry it).
+            line.append("\\u"_s, hex(c, 4, Lowercase));
+        } else
+            line.append(c);
+    }
+    String text = line.toString();
+    Locker locker { lock };
+    if (!recorded->add(text).isNewEntry)
+        return;
+    if (FILE* file = fopen(Options::aotRecordRegExpsPath(), "a")) {
+        CString utf8 = text.utf8();
+        fwrite(utf8.data(), 1, utf8.length(), file);
+        fputc('\n', file);
+        fclose(file);
+    }
+}
