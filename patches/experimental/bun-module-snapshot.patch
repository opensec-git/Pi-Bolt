new file mode 100644
index 0000000000..8b87112088
--- /dev/null
+++ b/src/js/bun/pibolt-snapshot.ts
@@ -0,0 +1,101 @@
+// Hardcoded module "bun:pibolt-snapshot"
+// Pi-Bolt's module-state snapshot: the runtime helpers of a bundle built with BUN_MODULE_SNAPSHOT_WRAP=1 call `enter()` and
+// `leave()` around each bundled module's top-level code (PiBoltSnapshot.cpp).
+const hooks = $cpp("PiBoltSnapshot.cpp", "createPiBoltSnapshotHooks");
+
+// While auditing (BUN_MODULE_SNAPSHOT_AUDIT): what a module's top-level code reads of the environment is noted for the module
+// that is running. Only then: these wrappers are not there otherwise.
+if (hooks.auditing) {
+  const note = hooks.note;
+  // The global object's, process's and Bun's lazily made properties are made now: otherwise the first module to read one
+  // would look as if it had changed them.
+  const reified = new Set();
+  const reify = (target, depth) => {
+    if ((typeof target !== "object" && typeof target !== "function") || target === null || reified.has(target)) return;
+    reified.add(target);
+    for (const key of Reflect.ownKeys(target)) {
+      if (target === process && (key === "stdin" || key === "stdout" || key === "stderr" || key === "env")) continue;
+      // (A descriptor, not a get: that makes a lazily made property without calling a getter.)
+      let descriptor;
+      try {
+        descriptor = Object.getOwnPropertyDescriptor(target, key);
+      } catch {}
+      if (depth > 0 && descriptor && "value" in descriptor) reify(descriptor.value, depth - 1);
+    }
+    if (depth > 0) {
+      try {
+        reify(Object.getPrototypeOf(target), depth - 1);
+      } catch {}
+    }
+  };
+  // (Two steps deep: the constructors, their prototypes and namespaces such as Intl, with their own lazily made properties.)
+  for (const target of [globalThis, process, Bun]) reify(target, 2);
+  const env = process.env;
+  const proxy = new Proxy(env, {
+    get(target, key) {
+      if (typeof key === "string") note("env", key, target[key]);
+      return Reflect.get(target, key);
+    },
+    has(target, key) {
+      if (typeof key === "string") note("env?", key, target[key]);
+      return Reflect.has(target, key);
+    },
+    ownKeys(target) {
+      note("env*");
+      return Reflect.ownKeys(target);
+    },
+    getOwnPropertyDescriptor(target, key) {
+      if (typeof key === "string") note("env", key, target[key]);
+      return Reflect.getOwnPropertyDescriptor(target, key);
+    },
+    set(target, key, value) {
+      if (typeof key === "string") note("env=", key, value);
+      return Reflect.set(target, key, value);
+    },
+    deleteProperty(target, key) {
+      if (typeof key === "string") note("env-", key);
+      return Reflect.deleteProperty(target, key);
+    },
+  });
+  Object.defineProperty(process, "env", { value: proxy, writable: true, enumerable: true, configurable: true });
+  for (const name of ["cwd", "chdir", "hrtime", "uptime", "memoryUsage", "cpuUsage", "umask", "on", "once", "addListener", "prependListener", "emitWarning", "nextTick", "exit", "kill"]) {
+    const original = process[name];
+    if (typeof original !== "function") continue;
+    const wrapped = function (...args) {
+      note("process." + name);
+      return original.$apply(this, args);
+    };
+    for (const key of Object.keys(original)) wrapped[key] = original[key];
+    process[name] = wrapped;
+  }
+  for (const name of ["argv", "execArgv", "pid", "ppid", "title", "stdout", "stderr", "stdin", "exitCode"]) {
+    const descriptor = Object.getOwnPropertyDescriptor(process, name);
+    if (!descriptor || !descriptor.configurable) continue;
+    let value = descriptor.get ? undefined : descriptor.value;
+    Object.defineProperty(process, name, {
+      get() {
+        note("process." + name);
+        return descriptor.get ? descriptor.get.$call(process) : value;
+      },
+      set(v) {
+        note("process." + name + "=");
+        if (descriptor.set) descriptor.set.$call(process, v);
+        else value = v;
+      },
+      enumerable: descriptor.enumerable,
+      configurable: true,
+    });
+  }
+  for (const name of ["setTimeout", "setInterval", "setImmediate", "queueMicrotask", "fetch"]) {
+    const original = globalThis[name];
+    if (typeof original !== "function") continue;
+    const wrapped = function (...args) {
+      note(name);
+      return original.$apply(this, args);
+    };
+    for (const key of Object.keys(original)) wrapped[key] = original[key];
+    globalThis[name] = wrapped;
+  }
+}
+
+export default hooks;
