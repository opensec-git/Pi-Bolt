+      await using proc = spawn({
+        cmd: [
+          "sh",
+          "-c",
+          `"$0" -e 'void process.stdout.isTTY; console.log(Buffer.alloc(1 << 20, "A").toString()); process.stdout.write(Buffer.alloc(1 << 20, "B"));' | cat`,
+          bunExe(),
+        ],
+        env: bunEnv,
+        stdout: "pipe",
+        stderr: "pipe",
