+static Vector<uint8_t> s_heapForExecutable; // What Bun__StaticHeap__takeBuilt() handed out, for Bun__StaticHeap__rewritePE().
+#endif
+
+// What the program's code was compiled for is how its bytecode is made, which is set before any is.
+extern "C" void Bun__setOptionsForAheadOfTimeCode()
+{
+    if (s_optionsOfMappedCode & AOTImageTrailer::immutableIntrinsics)
+        JSC::Options::useImmutableIntrinsics() = true;
+    if (s_optionsOfMappedCode & AOTImageTrailer::withoutJIT)
+        JSC::Options::useJIT() = false;
+    // Building: what JSC records for the JIT in the cells it makes (watchpoints, profiles) is not what the program finds when it
+    // runs, so the bundler's VM must not JIT. (Running: the trailer decides, above.)
+    if (!Bun__AOTImage__isMapped() && shouldBuildStaticHeap())
+        JSC::Options::useJIT() = false;
+    JSC::Options::resolveAllScopeSlotsStatically() = true;
+    JSC::Options::evaluateObjectLiteralValuesFirst() = true;
+    JSC::Options::definePlainInstanceFieldsInConstructor() = true;
+    // With the JIT off, JSC otherwise runs in "mini mode" (no generational GC, synchronous sweeping, 1.2x heap growth): meant for a VM
+    // that interprets everything, not for one whose code is compiled ahead of time. (OptionsList.h says so; nothing did it.)
+    JSC::Options::useMiniVMModeWithoutJIT() = false;
+}
+
+#if OS(DARWIN)
+// What of the heap points into this executable (moved, unless at the address it was linked for: c-bindings.cpp), and whether
+// anything points at a function or object of the system's libraries, which move at every boot: a heap must not. (A word in
+// their range that is not at the start of a symbol is taken for a number: the range is gigabytes wide.)
+static void checkPointersOutOfStaticHeap(std::span<const uint8_t> heap)
+{
+    const auto* header = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(0));
+    uintptr_t slide = _dyld_get_image_vmaddr_slide(0);
+    uintptr_t executableStart = 0, executableEnd = 0;
+    const auto* command = reinterpret_cast<const load_command*>(header + 1);
+    for (uint32_t i = 0; i < header->ncmds; ++i) {
+        if (command->cmd == LC_SEGMENT_64) {
+            const auto* segment = reinterpret_cast<const segment_command_64*>(command);
+            if (strcmp(segment->segname, "__PAGEZERO") && strcmp(segment->segname, "__LINKEDIT")) {
+                uintptr_t start = segment->vmaddr + slide;
+                if (!executableStart || start < executableStart)
+                    executableStart = start;
+                executableEnd = std::max<uintptr_t>(executableEnd, start + segment->vmsize);
+            }
+        }
+        command = reinterpret_cast<const load_command*>(reinterpret_cast<const uint8_t*>(command) + command->cmdsize);
+    }
+    size_t sharedCacheSize = 0;
+    uintptr_t sharedCache = 0;
+    // (Not in the SDK's headers.)
+    if (auto* range = reinterpret_cast<const void* (*)(size_t*)>(dlsym(RTLD_DEFAULT, "_dyld_get_shared_cache_range")))
+        sharedCache = reinterpret_cast<uintptr_t>(range(&sharedCacheSize));
+    size_t intoExecutable = 0, intoSystem = 0;
+    for (size_t at = 0; at + sizeof(uint64_t) <= heap.size(); at += sizeof(uint64_t)) {
+        uint64_t word;
+        memcpy(&word, heap.data() + at, sizeof(word));
+        if (word >= executableStart && word < executableEnd) {
+            ++intoExecutable;
+            continue;
+        }
+        if (word < sharedCache || word >= sharedCache + sharedCacheSize || word % 4)
+            continue;
+        Dl_info info;
+        // (A library's header, __dso_handle, is where nothing points: a round number that happens to be one. So is an address in a
+        // library of the cache that this process has not loaded.)
+        if (!dladdr(reinterpret_cast<const void*>(word), &info) || reinterpret_cast<uintptr_t>(info.dli_saddr) != word || info.dli_saddr == info.dli_fbase)
+            continue;
+        bool isLoaded = false;
+        for (uint32_t i = 0, count = _dyld_image_count(); i < count && !isLoaded; ++i)
+            isLoaded = _dyld_get_image_header(i) == info.dli_fbase;
+        if (!isLoaded)
+            continue;
+        if (intoSystem++ < 20)
+            fprintf(stderr, "warning: the static heap points at %s in %s (%llx, at %zu); it moves at every boot\n", info.dli_sname ? info.dli_sname : "?", info.dli_fname ? info.dli_fname : "?", static_cast<unsigned long long>(word), at);
+    }
+    if (getenv("BUN_STATIC_HEAP_VERBOSE") || intoSystem)
+        fprintf(stderr, "[static heap] %zu words point into the executable, %zu at the system's libraries\n", intoExecutable, intoSystem);
+}
+#endif
+
+extern "C" bool Bun__StaticHeap__takeBuilt(uint8_t** data, size_t* size)
+{
+    if (s_builtStaticHeap.isEmpty())
+        return false;
+#if OS(DARWIN)
+    if (_dyld_get_image_vmaddr_slide(0)) {
+        // (c-bindings.cpp starts a build with BUN_STATIC_HEAP=1 again at its linked address; that did not work.)
+        fprintf(stderr, "error: the static heap can only be built with the executable at the address it was linked for; building without it\n");
+        s_builtStaticHeap = { };
+        s_builtAOTImage = { };
+        return false;
+    }
+    checkPointersOutOfStaticHeap(s_builtStaticHeap.span());
+#endif
+    size_t offsetOfImage = WTF::roundUpToMultipleOf<pageSizeOfStaticHeap>(s_builtStaticHeap.size());
+    *size = s_builtAOTImage.isEmpty() ? s_builtStaticHeap.size() : offsetOfImage + s_builtAOTImage.size() + sizeof(AOTImageTrailer);
+    *data = static_cast<uint8_t*>(mi_zalloc(*size));
+    memcpy(*data, s_builtStaticHeap.span().data(), s_builtStaticHeap.size());
+    if (!s_builtAOTImage.isEmpty()) {
+        memcpy(*data + offsetOfImage, s_builtAOTImage.span().data(), s_builtAOTImage.size());
+        uint64_t options = JSC::Options::useImmutableIntrinsics() ? AOTImageTrailer::immutableIntrinsics : 0;
+        if (const char* jit = getenv("BUN_AOT_JIT"); jit && jit[0] == '0')
+            options |= AOTImageTrailer::withoutJIT;
+        AOTImageTrailer trailer { offsetOfImage, s_builtAOTImage.size(), cpuFeaturesOfCode(), options, AOTImageTrailer::expectedMagic };
+        memcpy(*data + *size - sizeof(trailer), &trailer, sizeof(trailer));
+    }
+#if OS(WINDOWS)
+    // The executable's writer puts the arenas and the code in the image as sections (Bun__StaticHeap__rewritePE()), from all of it;
+    // what goes in the module graph is only what says that those sections are this heap's (a heap's copy of its arenas would be
+    // in the executable twice): the header with a sample of the string table, and the image's first page with the trailer.
+    s_heapForExecutable = Vector<uint8_t>(std::span<const uint8_t> { *data, *size });
+    if (auto compact = JSC::StaticHeap::compactForExecutable(s_heapForExecutable.span()); !compact.isEmpty()) {
+        size_t compactImageAt = WTF::roundUpToMultipleOf<pageSizeOfStaticHeap>(compact.size());
+        size_t firstPage = std::min<size_t>(s_builtAOTImage.size(), pageSizeOfStaticHeap);
+        size_t compactSize = s_builtAOTImage.isEmpty() ? compact.size() : compactImageAt + firstPage + sizeof(AOTImageTrailer);
+        auto* compactData = static_cast<uint8_t*>(mi_zalloc(compactSize));
+        memcpy(compactData, compact.span().data(), compact.size());
+        if (!s_builtAOTImage.isEmpty()) {
+            memcpy(compactData + compactImageAt, s_builtAOTImage.span().data(), firstPage);
+            AOTImageTrailer trailer;
+            memcpy(&trailer, *data + *size - sizeof(trailer), sizeof(trailer));
+            trailer.offsetOfImage = compactImageAt;
+            trailer.optionsOfCode |= AOTImageTrailer::imageIsInExecutable;
+            memcpy(compactData + compactSize - sizeof(trailer), &trailer, sizeof(trailer));
+        }
+        mi_free(*data);
+        *data = compactData;
+        *size = compactSize;
+    }
+#endif
+    s_builtStaticHeap = { };
+    s_builtAOTImage = { };
+    return true;
+}
+
+extern "C" void Bun__StaticHeap__freeBuilt(uint8_t* data)
+{
+    mi_free(data);
+}
+
+// The code image that follows the static heap, if there is one (AOTImageTrailer): mapped where the static heap was built to find it,
+// the code executable and the rest read-only, and registered by Bun__AOTImage__register() once JSC is initialized.
+static std::span<const uint8_t> s_mappedAOTImage;
+static const void* s_codeOfMappedAOTImage;
+static const char* s_whyNotMapped; // When mapAOTImage() returns false for an image that is there.
+
+static bool hasAOTImageTrailer(const uint8_t* blob, size_t size)
+{
+    AOTImageTrailer trailer;
+    if (size < sizeof(trailer))
+        return false;
+    memcpy(&trailer, blob + size - sizeof(trailer), sizeof(trailer));
+    return trailer.magic == AOTImageTrailer::expectedMagic;
+}
+
+// False if the blob has an image that cannot be used: then the static heap, which was built for that code, is not used either.
+static bool mapAOTImage(const uint8_t* image, size_t size, int fd, uint64_t offsetInFile)
+{
+    bool verbose = getenv("BUN_STATIC_HEAP_VERBOSE");
+    // BUN_AOT=0: run without the code compiled ahead of time (to compare, or to rule it out).
+    if (const char* value = getenv("BUN_AOT"); value && value[0] == '0') {
+        if (verbose)
+            fprintf(stderr, "[aot] not used: BUN_AOT=0\n");
+        return !hasAOTImageTrailer(image, size);
+    }
+    if (!hasAOTImageTrailer(image, size))
+        return true; // A static heap without code.
+    AOTImageTrailer trailer;
+    memcpy(&trailer, image + size - sizeof(trailer), sizeof(trailer));
+    bool isInExecutable = trailer.optionsOfCode & AOTImageTrailer::imageIsInExecutable;
+    if (trailer.offsetOfImage % pageSizeOfStaticHeap || trailer.offsetOfImage > size - sizeof(trailer) || (!isInExecutable && trailer.sizeOfImage > size - trailer.offsetOfImage))
+        return false;
+    // (Before anything compares stamps: JSCInitialize() sets them again, as Options::initialize() resets every option.)
+    s_optionsOfMappedCode = trailer.optionsOfCode;
+    if (trailer.optionsOfCode & AOTImageTrailer::immutableIntrinsics)
+        JSC::Options::useImmutableIntrinsics() = true;
+    if (uint64_t missing = trailer.cpuFeatures & ~cpuFeaturesOfCode()) {
+        if (verbose)
+            fprintf(stderr, "[aot] not used: the code was compiled for CPU features this CPU lacks (%llx)\n", static_cast<unsigned long long>(missing));
+        s_whyNotMapped = "this CPU lacks an instruction set the code was compiled for";
+        return false;
+    }
+    std::span<const uint8_t> inFile { image + trailer.offsetOfImage, static_cast<size_t>(trailer.sizeOfImage) };
+    // What says that the code where it is expected is this image: its first bytes, here.
+    std::span<const uint8_t> sample = inFile;
+    if (isInExecutable) {
+        // The image is the executable's section; here, only its first page.
+#if OS(WINDOWS)
+        using Region = bmalloc::StaticRegion;
+        if (Region::layout().magic != bmalloc::StaticRegionLayout::expectedMagic || trailer.sizeOfImage > Region::reservationOf(Region::Arena::Image)) {
+            s_whyNotMapped = "the executable does not have the code image it says it has";
+            return false;
+        }
+        sample = { image + trailer.offsetOfImage, size - sizeof(trailer) - trailer.offsetOfImage };
+        inFile = { reinterpret_cast<const uint8_t*>(Region::startOf(Region::Arena::Image)), static_cast<size_t>(trailer.sizeOfImage) };
+#else
+        return false;
+#endif
+    }
+    auto range = JSC::aotImageCodeRange(inFile);
+    if (!range || range->first % pageSizeOfStaticHeap) {
+        if (verbose)
+            fprintf(stderr, "[aot] the image is not one for this engine\n");
+        s_whyNotMapped = "the image is not one for this engine";
+        return false;
+    }
+    using Region = bmalloc::StaticRegion;
+#if OS(WINDOWS)
+    // Not mapped: the image is a section of this executable already, the code executable (Bun__StaticHeap__rewritePE()). Its
+    // header, which has no pointers, says whether it is this one. (An executable without it has zeros there.)
+    UNUSED_PARAM(fd);
+    UNUSED_PARAM(offsetInFile);
+    // (An executable whose writer did not put the image in it has the runtime's own layout of the region: nothing is there.)
+    if (Region::layout().magic != bmalloc::StaticRegionLayout::expectedMagic || sample.size() < std::min<size_t>(range->first, 256)
+        || memcmp(reinterpret_cast<const void*>(Region::startOf(Region::Arena::Image)), sample.data(), std::min<size_t>(range->first, 256))) {
+#else
+    uint64_t at = offsetInFile + trailer.offsetOfImage;
+    if (!Region::map(Region::Arena::Image, fd, static_cast<off_t>(at), range->first, 0, false)
+        || !Region::map(Region::Arena::Image, fd, static_cast<off_t>(at + range->first), WTF::roundUpToMultipleOf(WTF::pageSize(), range->second), range->first, true)) {
+#endif
+        if (verbose)
+            fprintf(stderr, "[aot] the image could not be mapped\n");
+        s_whyNotMapped = "the image could not be mapped executable";
+        return false;
+    }
+    auto* base = reinterpret_cast<const uint8_t*>(Region::startOf(Region::Arena::Image));
+    s_mappedAOTImage = { base, inFile.size() };
+    s_codeOfMappedAOTImage = base + range->first;
+    if (verbose)
+        fprintf(stderr, "[aot] image of %zu bytes mapped, %zu of them code\n", inFile.size(), range->second);
+    return true;
+}
+
+extern "C" bool Bun__AOTImage__isMapped()
+{
+    return !s_mappedAOTImage.empty();
+}
+
+#if OS(WINDOWS)
+// The executable that `bun build --compile` writes on Windows, when it has a static heap: the runtime's section .pbreg, which is
+// bmalloc::StaticRegion (uninitialized and read-only in the runtime), becomes the arenas of the heap and the code image, as sections
+// at the addresses they were built at, relative to the image. Their pointers into the image (the region itself, and the
+// executable's code and data) are written as if the image were at its preferred base, with a base relocation each: the loader
+// moves them with the image, wherever Windows loads it, once for every process that runs it. The code is position-independent and is
+// not relocated. The rest of the region stays uninitialized (Bss is made writable as it is used), and the rest of the executable
+// is as it was.
+namespace {
+
+struct PESection {
+    char name[8];
+    uint32_t virtualSize;
+    uint32_t virtualAddress;
+    uint32_t sizeOfRawData;
+    uint32_t pointerToRawData;
+    uint32_t pointerToRelocations;
+    uint32_t pointerToLinenumbers;
+    uint16_t numberOfRelocations;
+    uint16_t numberOfLinenumbers;
+    uint32_t characteristics;
+};
+static_assert(sizeof(PESection) == 40);
+
+constexpr uint32_t scnCode = 0x20, scnInitializedData = 0x40, scnUninitializedData = 0x80;
+constexpr uint32_t scnDiscardable = 0x02000000, scnExecute = 0x20000000, scnRead = 0x40000000, scnWrite = 0x80000000;
+
+// A section of what replaces .pbreg: [start, end) of the image (RVAs), with its bytes if it has any.
+struct RegionSection {
+    const char* name;
+    uint32_t start;
+    uint32_t end;
+    uint32_t characteristics;
+    std::span<const uint8_t> bytes;
+};
+
+template<typename T> T readAt(std::span<const uint8_t> bytes, size_t at)
+{
+    T value;
+    RELEASE_ASSERT(at + sizeof(T) <= bytes.size());
+    memcpy(&value, bytes.data() + at, sizeof(T));
+    return value;
+}
+template<typename T> void writeAt(Vector<uint8_t>& bytes, size_t at, T value)
+{
+    RELEASE_ASSERT(at + sizeof(T) <= bytes.size());
+    memcpy(bytes.mutableSpan().data() + at, &value, sizeof(T));
+}
+
+uint32_t alignUp(uint32_t value, uint32_t alignment) { return (value + alignment - 1) & ~(alignment - 1); }
+
+// Base relocation blocks (IMAGE_REL_BASED_DIR64) for these RVAs, which are in order.
+Vector<uint8_t> relocationBlocks(const Vector<uint32_t>& rvas)
+{
+    Vector<uint8_t> out;
+    size_t at = 0;
+    while (at < rvas.size()) {
+        uint32_t page = rvas[at] & ~0xfffu;
+        Vector<uint16_t> entries;
+        for (; at < rvas.size() && (rvas[at] & ~0xfffu) == page; ++at)
+            entries.append(static_cast<uint16_t>(10 << 12 | (rvas[at] & 0xfff)));
+        if (entries.size() % 2)
+            entries.append(0); // IMAGE_REL_BASED_ABSOLUTE: padding
+        uint32_t header[2] = { page, static_cast<uint32_t>(8 + 2 * entries.size()) };
+        out.append(std::span { reinterpret_cast<const uint8_t*>(header), sizeof(header) });
+        out.append(std::span { reinterpret_cast<const uint8_t*>(entries.span().data()), entries.size() * 2 });
+    }
+    return out;
+}
+
+} // namespace
+
+// Returns 1 and the new executable in `out` (mi_free() it), 0 if there is nothing to do (no static heap was built), or -1 with
+// `error` saying why it cannot be done.
+extern "C" int Bun__StaticHeap__rewritePE(const uint8_t* input, size_t inputSize, uint8_t** out, size_t* outSize, const char** error)
+{
+    *out = nullptr;
+    *outSize = 0;
+    *error = nullptr;
+    if (s_heapForExecutable.isEmpty())
+        return 0;
+    auto fail = [&](const char* why) {
+        *error = why;
+        s_heapForExecutable = { };
+        return -1;
+    };
+    std::span<const uint8_t> pe { input, inputSize };
+    std::span<const uint8_t> blob = s_heapForExecutable.span();
+    using Region = bmalloc::StaticRegion;
+
+    // ---- The executable as it is.
+    if (pe.size() < 0x200 || readAt<uint16_t>(pe, 0) != 0x5a4d)
+        return fail("not a PE executable");
+    uint32_t peOffset = readAt<uint32_t>(pe, 0x3c);
+    if (readAt<uint32_t>(pe, peOffset) != 0x4550)
+        return fail("not a PE executable");
+    uint16_t numberOfSections = readAt<uint16_t>(pe, peOffset + 6);
+    uint16_t sizeOfOptionalHeader = readAt<uint16_t>(pe, peOffset + 20);
+    size_t optional = peOffset + 24;
+    if (readAt<uint16_t>(pe, optional) != 0x20b)
+        return fail("not a 64-bit executable");
+    uint64_t preferredBase = readAt<uint64_t>(pe, optional + 24);
+    uint32_t sectionAlignment = readAt<uint32_t>(pe, optional + 32);
+    uint32_t fileAlignment = readAt<uint32_t>(pe, optional + 36);
+    uint32_t sizeOfHeaders = readAt<uint32_t>(pe, optional + 60);
+    size_t directories = optional + 112;
+    size_t sectionTable = optional + sizeOfOptionalHeader;
+    Vector<PESection> sections;
+    for (unsigned i = 0; i < numberOfSections; ++i)
+        sections.append(readAt<PESection>(pe, sectionTable + i * sizeof(PESection)));
+    size_t indexOfRegion = notFound;
+    for (size_t i = 0; i < sections.size(); ++i) {
+        if (!memcmp(sections[i].name, ".pbreg\0\0", 8))
+            indexOfRegion = i;
+    }
+    if (indexOfRegion == notFound)
+        return fail("the executable has no .pbreg section (it is not the Pi-Bolt runtime)");
+    PESection regionSection = sections[indexOfRegion];
+
+    // ---- This process: the runtime the heap was built in, which must be the same executable (its region at the same RVA).
+    auto* image = reinterpret_cast<const uint8_t*>(GetModuleHandleW(nullptr));
+    uintptr_t imageStart = reinterpret_cast<uintptr_t>(image);
+    auto* ownNT = image + *reinterpret_cast<const uint32_t*>(image + 0x3c);
+    uintptr_t imageEnd = imageStart + *reinterpret_cast<const uint32_t*>(ownNT + 24 + 56); // SizeOfImage
+    uint32_t regionRVA = static_cast<uint32_t>(Region::base() - imageStart);
+    if (regionRVA != alignUp(regionSection.virtualAddress, 0x10000))
+        return fail("the static heap was built by another executable than the one being written");
+    if (JSC::StaticHeap::regionBaseOf(blob) != Region::base())
+        return fail("the static heap was built at another address");
+
+    // ---- What goes into the region: the heap's arenas, and the code image with its trailer.
+    auto parts = JSC::StaticHeap::partsOf(blob);
+    if (parts.isEmpty())
+        return fail("the static heap is not one for this engine");
+    struct Part {
+        uint32_t offsetInRegion;
+        std::span<const uint8_t> bytes;
+        uint32_t characteristics;
+        bool hasPointers;
+    };
+    Vector<Part> inRegion;
+    Vector<uint32_t> codeCallTargets; // RVAs of the compiled code's entry points that C++ calls through a pointer
+    for (auto& part : parts) {
+        if (!part.size)
+            continue;
+        if (part.offsetInImage > blob.size() || part.size > blob.size() - part.offsetInImage || part.offsetInRegion > Region::layout().extent || part.size > Region::layout().extent - part.offsetInRegion)
+            return fail("the static heap is malformed");
+        // The arenas that running the program writes to are writable; the others are read-only, which no process is charged for,
+        // and what is written to there all the same is made writable a page at a time (bmalloc::StaticRegion's exception
+        // handler), as on Linux, where they are private mappings of the file.
+        inRegion.append({ static_cast<uint32_t>(part.offsetInRegion), blob.subspan(part.offsetInImage, part.size), part.isMutable ? scnInitializedData | scnRead | scnWrite : scnInitializedData | scnRead, true });
+    }
+    if (hasAOTImageTrailer(blob.data(), blob.size())) {
+        AOTImageTrailer trailer;
+        memcpy(&trailer, blob.data() + blob.size() - sizeof(trailer), sizeof(trailer));
+        if (trailer.offsetOfImage > blob.size() || trailer.sizeOfImage > blob.size() - trailer.offsetOfImage || trailer.sizeOfImage > Region::reservationOf(Region::Arena::Image))
+            return fail("the code image is malformed");
+        auto codeImage = blob.subspan(trailer.offsetOfImage, trailer.sizeOfImage);
+        auto range = JSC::aotImageCodeRange(codeImage);
+        if (!range || range->first % 4096 || range->first + range->second > codeImage.size())
+            return fail("the code image is not one for this engine");
+        uint32_t startOfImage = static_cast<uint32_t>(Region::startOf(Region::Arena::Image) - Region::base());
+        size_t endOfCode = WTF::roundUpToMultipleOf<4096>(range->first + range->second);
+        // The code's tables, before it; the code itself (executable, never writable); what follows it. None has a pointer: the
+        // image has no absolute addresses (AOTImage.h), so none of its bytes is relocated, or taken for an address the
+        // relocation missed (which a number in its tables can look like).
+        inRegion.append({ startOfImage, codeImage.first(range->first), scnInitializedData | scnRead, false });
+        inRegion.append({ startOfImage + static_cast<uint32_t>(range->first), codeImage.subspan(range->first, range->second), scnCode | scnExecute | scnRead, false });
+        for (uint32_t offset : JSC::aotImageIndirectCallTargets(codeImage))
+            codeCallTargets.append(regionRVA + startOfImage + static_cast<uint32_t>(range->first) + offset);
+        if (endOfCode < codeImage.size())
+            inRegion.append({ startOfImage + static_cast<uint32_t>(endOfCode), codeImage.subspan(endOfCode), scnInitializedData | scnRead, true });
+    }
+    std::ranges::sort(inRegion, { }, &Part::offsetInRegion);
+    // Where the region ends in the executable: after the last part (the arenas' room to grow while building is not in it, nor
+    // Arena::Scratch, which only a build has).
+    uint64_t endOfParts = 0;
+    for (auto& part : inRegion)
+        endOfParts = std::max<uint64_t>(endOfParts, part.offsetInRegion + WTF::roundUpToMultipleOf<4096>(part.bytes.size()));
+    // How big the arenas were for this build (BUN_STATIC_REGION_SIZES_OUT): a build after this one with
+    // BUN_STATIC_REGION_SIZES set to it makes the same heap with the arenas side by side, and so an executable without room
+    // between them, which would be uninitialized and charged to the system's commit (scripts\build-pi.ps1 builds twice).
+    if (const char* sizesOut = getenv("BUN_STATIC_REGION_SIZES_OUT")) {
+        // (Each with a little to spare; Scratch, which is in no file, with more.)
+        auto sizeOf = [](Region::Arena arena, size_t spare) { return WTF::roundUpToMultipleOf<0x10000>(Region::used(arena) + spare); };
+        size_t imageSize = 0;
+        if (hasAOTImageTrailer(blob.data(), blob.size())) {
+            AOTImageTrailer trailer;
+            memcpy(&trailer, blob.data() + blob.size() - sizeof(trailer), sizeof(trailer));
+            imageSize = WTF::roundUpToMultipleOf<0x10000>(trailer.sizeOfImage + 0x10000);
+        }
+        if (FILE* file = fopen(sizesOut, "w")) {
+            fprintf(file, "%zu,%zu,%zu,%zu,%zu,%zu,%zu\n", sizeOf(Region::Arena::Data, 0x40000), sizeOf(Region::Arena::Malloc, 0x40000), sizeOf(Region::Arena::Cells, 0x40000),
+                sizeOf(Region::Arena::MutableCells, 0x40000), sizeOf(Region::Arena::MutableMalloc, 0x40000), imageSize, sizeOf(Region::Arena::Scratch, 16 << 20));
+            fclose(file);
+        }
+    }
+
+    // ---- Their pointers into the image, at the preferred base, and a relocation for each. A pointer anywhere else in the
+    // process that a static heap holds would not be good in another process: other modules move at every boot.
+    HMODULE modules[1024];
+    DWORD bytesOfModules = 0;
+    // (Without the list, a pointer into a system library would go unnoticed, and be wrong at the next boot.)
+    if (!EnumProcessModules(GetCurrentProcess(), modules, sizeof(modules), &bytesOfModules))
+        return fail("the process's modules could not be listed");
+    Vector<std::pair<uintptr_t, uintptr_t>> otherModules;
+    // (What it says is how much room all of them need, which may be more than there is: the first 1,024 are what it wrote.)
+    for (unsigned i = 0; i < std::min<size_t>(bytesOfModules, sizeof(modules)) / sizeof(HMODULE); ++i) {
+        MODULEINFO info;
+        if (modules[i] != reinterpret_cast<HMODULE>(const_cast<uint8_t*>(image)) && GetModuleInformation(GetCurrentProcess(), modules[i], &info, sizeof(info)))
+            otherModules.append({ reinterpret_cast<uintptr_t>(info.lpBaseOfDll), reinterpret_cast<uintptr_t>(info.lpBaseOfDll) + info.SizeOfImage });
+    }
+    Vector<Vector<uint8_t>> rebased; // The parts' bytes, with their pointers at the preferred base.
+    Vector<uint32_t> relocations;
+    size_t pointersIntoOtherModules = 0;
+    // The words that hold an address in the region with something in its top 16 bits (and perhaps its low three): the entry word
+    // of compiled code (AOT::EntryWord, the number of parameters above the address), FunctionInfo's executable (its flags above it).
+    // The builder says where they are. The relocation adds the move to the whole word, which leaves those bits as they are: it is a
+    // multiple of 64 KB, and an address of a user's process is below 2^48. Anything else that looks like one is counted, not moved
+    // (a double could): building twice says whether it was a pointer after all (scripts/lib/compare-static-heaps.py).
+    constexpr uint64_t addressBits = (1ull << 48) - 1;
+    auto taggedWords = JSC::StaticHeap::taggedWordsOfBuiltImage();
+    size_t nextTaggedWord = 0;
+    size_t taggedWordsMoved = 0;
+    size_t looksTaggedButIsNotListed = 0;
+    size_t pointersToWhatIsNotKept = 0;
+    size_t wordsThatOnlyLookLikeWhatIsNotKept = 0;
+    uintptr_t endOfExecutable = std::max<uintptr_t>(imageEnd, Region::base() + endOfParts);
+    for (auto& part : inRegion) {
+        Vector<uint8_t> bytes(part.bytes);
+        if (part.hasPointers) {
+            while (nextTaggedWord < taggedWords.size() && taggedWords[nextTaggedWord] < part.offsetInRegion)
+                ++nextTaggedWord;
+            for (size_t at = 0; at + 8 <= bytes.size(); at += 8) {
+                uint64_t word;
+                memcpy(&word, bytes.span().data() + at, 8);
+                uint64_t target = word & addressBits & ~7ull;
+                bool targetIsInRegion = target - Region::base() < endOfParts;
+                if (nextTaggedWord < taggedWords.size() && taggedWords[nextTaggedWord] == part.offsetInRegion + at) {
+                    ++nextTaggedWord;
+                    if (!targetIsInRegion)
+                        return fail("the static heap has an entry word that is not of its code");
+                    writeAt<uint64_t>(bytes, at, (word & ~addressBits) | ((word & addressBits) - imageStart + preferredBase));
+                    relocations.append(regionRVA + part.offsetInRegion + static_cast<uint32_t>(at));
+                    ++taggedWordsMoved;
+                    continue;
+                }
+                // (Arena::Scratch and the blocks are not in the executable: what is there is not kept, or made by a running program,
+                // and nothing may point to it.) A pointer to something there is to an object, at an address that is a multiple of 8,
+                // in memory that is committed (the blocks and the arena are committed as they are used). A word that is neither is
+                // not one: a pair of 32-bit numbers can look like an address there, as the blocks are where a reservation of their
+                // size fits at the top, just below the Control Flow Guard bitmap (0x7DF3...: Pi 1.1.0's data held 0x5002d, 0x7df4).
+                if (word - Region::startOf(Region::Arena::Scratch) < Region::reservationOf(Region::Arena::Scratch) || word - Region::startOfBlocks() < Region::sizeOfBlocks()) {
+                    MEMORY_BASIC_INFORMATION target;
+                    bool couldBeAPointer = !(word & 7)
+                        && VirtualQuery(reinterpret_cast<const void*>(static_cast<uintptr_t>(word)), &target, sizeof(target))
+                        && target.State == MEM_COMMIT;
+                    uintptr_t where = Region::base() + part.offsetInRegion + at;
+                    if (!couldBeAPointer) {
+                        // (Said in every build, so that the log shows it: a pointer with a tag in its low bits, or to a page given
+                        // back, would also be taken for a number here. Building with the blocks elsewhere tells them apart.)
+                        if (wordsThatOnlyLookLikeWhatIsNotKept++ < 10)
+                            fprintf(stderr, "note: a word that looks like an address of what is not kept is taken for a number (%llx, in %s)\n",
+                                static_cast<unsigned long long>(word), JSC::StaticHeap::describeBuiltAddress(where).data());
+                        continue;
+                    }
+                    if (pointersToWhatIsNotKept++ < 10) {
+                        fprintf(stderr, "warning: the static heap points to what is not kept (%llx, at offset %zu of a part at %x, in %s; blocks at %p, scratch at %p)\n",
+                            static_cast<unsigned long long>(word), at, part.offsetInRegion, JSC::StaticHeap::describeBuiltAddress(where).data(),
+                            reinterpret_cast<void*>(Region::startOfBlocks()), reinterpret_cast<void*>(Region::startOf(Region::Arena::Scratch)));
+                    }
+                    continue;
+                }
+                if (word >= imageStart && word < endOfExecutable) {
+                    writeAt<uint64_t>(bytes, at, word - imageStart + preferredBase);
+                    relocations.append(regionRVA + part.offsetInRegion + static_cast<uint32_t>(at));
+                    continue;
+                }
+                if ((word >> 48) && targetIsInRegion)
+                    ++looksTaggedButIsNotListed;
+                for (auto& [start, end] : otherModules) {
+                    if (word >= start && word < end && pointersIntoOtherModules++ < 10)
+                        fprintf(stderr, "warning: the static heap points into another module (%llx, at offset %zu of a part at %x)\n", static_cast<unsigned long long>(word), at, part.offsetInRegion);
+                }
+            }
+        }
+        rebased.append(WTF::move(bytes));
+    }
+    if (pointersIntoOtherModules)
+        return fail("the static heap points into a system library, which moves at every boot");
+    if (wordsThatOnlyLookLikeWhatIsNotKept > 10)
+        fprintf(stderr, "note: %zu words in all look like addresses of what is not kept and are taken for numbers\n", wordsThatOnlyLookLikeWhatIsNotKept);
+    if (pointersToWhatIsNotKept)
+        return fail("the static heap points to memory that is not in the executable (the build's scratch memory, or a running program's blocks)");
+    // What is left that looks like an address in this process's image, now that its pointers are at the preferred base: a pointer
+    // that is not on an 8-byte boundary (a packed one), or bytes that were never written and kept an address from the process
+    // that built the heap. Either would be wrong in another process, and either is told by building twice only by chance. One on an
+    // 8-byte boundary fails the build. Between two such words (a 4-byte boundary) it is only said: there it is the halves of two
+    // words, data as often as not (a number's upper half next to another's lower half), and whether it falls in the range of the
+    // executable depends on where Windows loaded the process, which is the same all through a boot, so failing would stop every
+    // build until the next one. (A packed pointer is caught by building twice, -VerifyDeterminism.)
+    size_t notRelocated = 0;
+    size_t notRelocatedBetweenWords = 0;
+    for (size_t i = 0; i < inRegion.size(); ++i) {
+        if (!inRegion[i].hasPointers)
+            continue;
+        auto bytes = rebased[i].span();
+        for (size_t at = 0; at + 8 <= bytes.size(); at += 4) {
+            uint64_t word;
+            memcpy(&word, bytes.data() + at, 8);
+            if (at % 8) {
+                if (word >= imageStart && word < endOfExecutable && notRelocatedBetweenWords++ < 3 && getenv("BUN_STATIC_HEAP_VERBOSE"))
+                    fprintf(stderr, "[static heap] between two words, something that looks like an address of this process: %llx, at offset %zu of a part at %x\n",
+                        static_cast<unsigned long long>(word), at, inRegion[i].offsetInRegion);
+                continue;
+            }
+            if (word >= imageStart && word < endOfExecutable && notRelocated++ < 10) {
+                fprintf(stderr, "warning: the static heap has an address of the process that built it that is not relocated (%llx, at offset %zu of a part at %x%s); the bytes around it:",
+                    static_cast<unsigned long long>(word), at, inRegion[i].offsetInRegion, inRegion[i].characteristics & scnExecute ? ", code" : "");
+                for (size_t b = at >= 16 ? at - 16 : 0; b < std::min(bytes.size(), at + 24); ++b)
+                    fprintf(stderr, "%s%02x", b == at ? " [" : " ", bytes[b]);
+                uintptr_t where = Region::base() + inRegion[i].offsetInRegion + at;
+                fprintf(stderr, " (at %p, in %s; the structure heap starts at %p)\n", reinterpret_cast<void*>(where),
+                    JSC::StaticHeap::describeBuiltAddress(where).data(), reinterpret_cast<void*>(g_jscConfig.startOfStructureHeap));
+            }
+        }
+    }
+    if (notRelocated)
+        return fail("the static heap has addresses that cannot be relocated (bytes never written, which kept an address of the process that built it)");
+    if (taggedWordsMoved != taggedWords.size())
+        return fail("the static heap's entry words are not all in its parts");
+    if (getenv("BUN_STATIC_HEAP_VERBOSE")) {
+        fprintf(stderr, "[static heap] %zu pointers into the executable, relocated (%zu of them entry words)\n", relocations.size(), taggedWordsMoved);
+        if (looksTaggedButIsNotListed)
+            fprintf(stderr, "[static heap] %zu words look like entry words but are not listed as any; not moved\n", looksTaggedButIsNotListed);
+    }
+
+    // ---- The arenas: sections after the executable's own, where the build had them (the layout says where; .pblay below), with
+    // uninitialized read-only sections where there is nothing (what is left over of an arena, a hole in Arena::Data). .pbreg, the
+    // start of the region and what of Arena::Bss is in the image, stays as it is.
+    uint32_t endOfImage = 0;
+    for (auto& s : sections)
+        endOfImage = std::max(endOfImage, s.virtualAddress + alignUp(std::max(s.virtualSize, s.sizeOfRawData), sectionAlignment));
+    Vector<RegionSection> newSections;
+    uint32_t at = endOfImage;
+    auto gapTo = [&](uint32_t end) {
+        if (end > at)
+            newSections.append({ ".pbgap", at, end, scnUninitializedData | scnRead, { } });
+        at = end;
+    };
+    for (size_t i = 0; i < inRegion.size(); ++i) {
+        auto& part = inRegion[i];
+        uint64_t start = regionRVA + static_cast<uint64_t>(part.offsetInRegion);
+        uint64_t end = start + alignUp(static_cast<uint32_t>(part.bytes.size()), sectionAlignment);
+        if (start < at || end > (1ull << 31))
+            return fail("the static heap's arenas are not after the executable (another runtime than the one that built it?)");
+        gapTo(static_cast<uint32_t>(start));
+        bool isOfCodeImage = part.offsetInRegion >= Region::startOf(Region::Arena::Image) - Region::base();
+        const char* name = part.characteristics & scnExecute ? ".pbcode" : (isOfCodeImage ? ".pbimage" : ".pbheap");
+        newSections.append({ name, static_cast<uint32_t>(start), static_cast<uint32_t>(end), part.characteristics, rebased[i].span() });
+        at = static_cast<uint32_t>(end);
+    }
+    uint32_t endOfRegion = at;
+
+    // ---- The base relocations: the executable's own, then these, in a section of their own at the end.
+    std::span<const uint8_t> oldRelocations;
+    uint32_t relocationsRVA = readAt<uint32_t>(pe, directories + 5 * 8);
+    uint32_t relocationsSize = readAt<uint32_t>(pe, directories + 5 * 8 + 4);
+    auto fileOffsetOf = [&](uint32_t rva) -> std::optional<size_t> {
+        for (auto& s : sections) {
+            if (rva >= s.virtualAddress && rva < s.virtualAddress + std::max(s.virtualSize, s.sizeOfRawData) && rva - s.virtualAddress < s.sizeOfRawData) {
+                if (static_cast<size_t>(s.pointerToRawData) + s.sizeOfRawData > pe.size())
+                    return std::nullopt;
+                return s.pointerToRawData + (rva - s.virtualAddress);
+            }
+        }
+        return std::nullopt;
+    };
+    if (relocationsSize) {
+        auto offset = fileOffsetOf(relocationsRVA);
+        if (!offset || *offset + relocationsSize > pe.size())
+            return fail("the executable's base relocations are malformed");
+        oldRelocations = pe.subspan(*offset, relocationsSize);
+    }
+    Vector<uint8_t> allRelocations(oldRelocations);
+    allRelocations.append(relocationBlocks(relocations).span());
+    RegionSection relocationSection { ".pbreloc", endOfRegion, endOfRegion + alignUp(static_cast<uint32_t>(allRelocations.size()), sectionAlignment), scnInitializedData | scnRead | scnDiscardable, allRelocations.span() };
+
+    // ---- Unwind information for the compiled code, so that stack walks (exceptions, crash reports, debuggers) go through its
+    // frames. For an address in an image Windows only looks at the image's own exception directory: the executable's entries,
+    // then one for the code, sorted (the code's addresses are above the executable's own code). Every frame of compiled code is
+    // the caller's frame pointer and the return address, below which the function keeps its things (push rbp; mov rbp, rsp): one
+    // UNWIND_INFO says so for all of it. (A frameless stub that calls C is taken for the frame of whoever called it, which then
+    // does not show: the walk goes on all the same.)
+    Vector<uint8_t> exceptionData;
+    uint32_t exceptionTableRVA = 0, exceptionTableSize = 0;
+    std::optional<RegionSection> exceptionSection;
+    if (auto code = std::ranges::find_if(inRegion, [](auto& part) { return part.characteristics & scnExecute; }); code != inRegion.end()) {
+        uint32_t oldRVA = readAt<uint32_t>(pe, directories + 3 * 8);
+        uint32_t oldSize = readAt<uint32_t>(pe, directories + 3 * 8 + 4);
+        std::span<const uint8_t> oldEntries;
+        if (oldSize) {
+            auto offset = fileOffsetOf(oldRVA);
+            if (!offset || *offset + oldSize > pe.size() || oldSize % 12)
+                return fail("the executable's exception directory is malformed");
+            oldEntries = pe.subspan(*offset, oldSize);
+        }
+        uint32_t codeStart = regionRVA + code->offsetInRegion;
+        if (!oldEntries.empty() && readAt<uint32_t>(oldEntries, oldEntries.size() - 8) > codeStart)
+            return fail("the executable's code is above the static region");
+        uint32_t sectionRVA = relocationSection.end;
+        // UNWIND_INFO: version 1, no flags, no prologue, two codes, frame register rbp (5) at offset 0; the codes in the reverse
+        // order of the prologue: UWOP_SET_FPREG (3), then UWOP_PUSH_NONVOL (0) of rbp (5).
+        const uint8_t unwindInfo[8] = { 1, 0, 2, 0x05, 0, 0x03, 0, 0x50 };
+        exceptionData.append(std::span { unwindInfo });
+        exceptionTableRVA = sectionRVA + static_cast<uint32_t>(exceptionData.size());
+        exceptionData.append(oldEntries);
+        const uint32_t codeEntry[3] = { codeStart, codeStart + static_cast<uint32_t>(code->bytes.size()), sectionRVA };
+        exceptionData.append(std::span { reinterpret_cast<const uint8_t*>(codeEntry), sizeof(codeEntry) });
+        exceptionTableSize = static_cast<uint32_t>(oldEntries.size() + sizeof(codeEntry));
+        exceptionSection = RegionSection { ".pbpdata", sectionRVA, sectionRVA + alignUp(static_cast<uint32_t>(exceptionData.size()), sectionAlignment), scnInitializedData | scnRead, exceptionData.span() };
+    }
+    // ---- Control Flow Guard: an indirect call is allowed only to a target that the image's table lists (the loader makes its
+    // bitmap of valid targets from it). The compiled code's entry points that C++ calls through a pointer (the regular
+    // expressions, which WTF::callSysV() checks) are added: the executable's table, with them, sorted, in a section of its own,
+    // to which the load configuration then points. (Its pointer to the table already has a base relocation.)
+    Vector<uint8_t> guardTable;
+    std::optional<RegionSection> guardSection;
+    std::optional<size_t> loadConfigOffset;
+    uint32_t guardTableCount = 0;
+    if (uint32_t loadConfigRVA = readAt<uint32_t>(pe, directories + 10 * 8); loadConfigRVA && !codeCallTargets.isEmpty()) {
+        loadConfigOffset = fileOffsetOf(loadConfigRVA);
+        if (!loadConfigOffset || *loadConfigOffset + 0x94 > pe.size() || readAt<uint32_t>(pe, *loadConfigOffset) < 0x94)
+            return fail("the executable's load configuration is malformed");
+        uint64_t tableVA = readAt<uint64_t>(pe, *loadConfigOffset + 0x80); // GuardCFFunctionTable
+        uint64_t count = readAt<uint64_t>(pe, *loadConfigOffset + 0x88); // GuardCFFunctionCount
+        uint32_t guardFlags = readAt<uint32_t>(pe, *loadConfigOffset + 0x90);
+        constexpr uint32_t instrumented = 0x100, tablePresent = 0x400; // IMAGE_GUARD_CF_INSTRUMENTED, IMAGE_GUARD_CF_FUNCTION_TABLE_PRESENT
+        if (guardFlags & instrumented) {
+            if (!(guardFlags & tablePresent) || tableVA < preferredBase)
+                return fail("the executable has Control Flow Guard but no table of the targets it allows");
+            size_t stride = 4 + ((guardFlags >> 28) & 0xf); // an RVA, then that many bytes of flags
+            auto tableOffset = fileOffsetOf(static_cast<uint32_t>(tableVA - preferredBase));
+            if (!tableOffset || count > (pe.size() - *tableOffset) / stride)
+                return fail("the executable's table of Control Flow Guard targets is malformed");
+            auto old = pe.subspan(*tableOffset, count * stride);
+            size_t next = 0;
+            uint32_t last = 0;
+            auto append = [&](uint32_t rva, std::span<const uint8_t> flags) {
+                if (guardTableCount && rva <= last)
+                    return; // (sorted, once each)
+                guardTable.append(std::span { reinterpret_cast<const uint8_t*>(&rva), 4 });
+                guardTable.append(flags);
+                last = rva;
+                ++guardTableCount;
+            };
+            const uint8_t noFlags[16] = { };
+            for (size_t i = 0; i < count; ++i) {
+                uint32_t rva = readAt<uint32_t>(old, i * stride);
+                for (; next < codeCallTargets.size() && codeCallTargets[next] < rva; ++next)
+                    append(codeCallTargets[next], std::span { noFlags }.first(stride - 4));
+                append(rva, old.subspan(i * stride + 4, stride - 4));
+            }
+            for (; next < codeCallTargets.size(); ++next)
+                append(codeCallTargets[next], std::span { noFlags }.first(stride - 4));
+            uint32_t sectionRVA = exceptionSection ? exceptionSection->end : relocationSection.end;
+            guardSection = RegionSection { ".pbgfids", sectionRVA, sectionRVA + alignUp(static_cast<uint32_t>(guardTable.size()), sectionAlignment), scnInitializedData | scnRead, guardTable.span() };
+        }
+    }
+    // ---- The new file: the headers (with room for the new section table), then every section's bytes in the order of their addresses.
+    struct NewSection {
+        PESection header;
+        std::span<const uint8_t> bytes;
+        uint32_t oldPointer; // For finding what of the old file was in it (the debug directory's data).
+    };
+    Vector<NewSection> table;
+    for (auto& s : sections) {
+        if (s.sizeOfRawData && s.pointerToRawData + s.sizeOfRawData > pe.size())
+            return fail("the executable is truncated");
+        table.append({ s, s.sizeOfRawData ? pe.subspan(s.pointerToRawData, s.sizeOfRawData) : std::span<const uint8_t> { }, s.pointerToRawData });
+    }
+    for (auto& n : newSections) {
+        PESection s { };
+        memcpy(s.name, n.name, std::min<size_t>(strlen(n.name), 8));
+        s.virtualAddress = n.start;
+        s.virtualSize = n.end - n.start;
+        s.characteristics = n.characteristics;
+        table.append({ s, n.bytes, 0 });
+    }
+    // (Windows refuses an image of about 2 GB as "not a valid application"; 1.7 GB loads. The .bun section comes after this.)
+    if (static_cast<uint64_t>(guardSection ? guardSection->end : exceptionSection ? exceptionSection->end : relocationSection.end) + blob.size() > 1600ull << 20)
+        return fail("the executable would be too large for Windows to load (over 1.6 GB of image)");
+    uint32_t newEndOfImage = relocationSection.end;
+    for (auto* added : { &relocationSection, exceptionSection ? &*exceptionSection : nullptr, guardSection ? &*guardSection : nullptr }) {
+        if (!added)
+            continue;
+        PESection s { };
+        memcpy(s.name, added->name, std::min<size_t>(strlen(added->name), 8));
+        s.virtualAddress = added->start;
+        s.virtualSize = static_cast<uint32_t>(added->bytes.size());
+        s.characteristics = added->characteristics;
+        table.append({ s, added->bytes, 0 });
+        newEndOfImage = added->end;
+    }
+    // (With room for a few more: .bun is added after this.)
+    uint32_t newSizeOfHeaders = std::max(sizeOfHeaders, alignUp(static_cast<uint32_t>(sectionTable + (table.size() + 4) * sizeof(PESection)), fileAlignment));
+    uint32_t firstSection = UINT32_MAX;
+    for (auto& s : sections)
+        firstSection = std::min(firstSection, s.virtualAddress);
+    if (newSizeOfHeaders > firstSection)
+        return fail("no room in the executable's headers for the static heap's sections");
+    Vector<uint8_t> result;
+    // (Vector::grow() leaves new bytes as they were: what pads the file is zeros.)
+    auto growWithZeros = [&](size_t size) {
+        size_t old = result.size();
+        result.grow(size);
+        memset(result.mutableSpan().data() + old, 0, size - old);
+    };
+    result.append(pe.first(std::min<size_t>(sizeOfHeaders, sectionTable)));
+    growWithZeros(newSizeOfHeaders);
+    Vector<std::pair<uint32_t, uint32_t>> movedFrom; // (old pointer, new pointer), for the debug directory
+    for (auto& s : table) {
+        if (s.bytes.empty()) {
+            s.header.sizeOfRawData = 0;
+            s.header.pointerToRawData = 0;
+            continue;
+        }
+        size_t pointer = WTF::roundUpToMultipleOf(fileAlignment, result.size());
+        growWithZeros(pointer);
+        result.append(s.bytes);
+        growWithZeros(WTF::roundUpToMultipleOf(fileAlignment, result.size()));
+        if (s.oldPointer)
+            movedFrom.append({ s.oldPointer, static_cast<uint32_t>(pointer) });
+        s.header.pointerToRawData = static_cast<uint32_t>(pointer);
+        s.header.sizeOfRawData = static_cast<uint32_t>(WTF::roundUpToMultipleOf(fileAlignment, s.bytes.size()));
+    }
+    for (size_t i = 0; i < table.size(); ++i)
+        writeAt<PESection>(result, sectionTable + i * sizeof(PESection), table[i].header);
+    writeAt<uint16_t>(result, peOffset + 6, static_cast<uint16_t>(table.size()));
+    writeAt<uint32_t>(result, optional + 60, newSizeOfHeaders);
+    writeAt<uint32_t>(result, optional + 56, newEndOfImage); // SizeOfImage
+    if (exceptionSection) {
+        writeAt<uint32_t>(result, directories + 3 * 8, exceptionTableRVA);
+        writeAt<uint32_t>(result, directories + 3 * 8 + 4, exceptionTableSize);
+    }
+    writeAt<uint32_t>(result, optional + 64, 0); // CheckSum: the writer recomputes it after adding .bun
+    writeAt<uint32_t>(result, directories + 5 * 8, relocationSection.start);
+    writeAt<uint32_t>(result, directories + 5 * 8 + 4, static_cast<uint32_t>(allRelocations.size()));
+    // A signature does not survive this (nor the .bun section after it).
+    writeAt<uint32_t>(result, directories + 4 * 8, 0);
+    writeAt<uint32_t>(result, directories + 4 * 8 + 4, 0);
