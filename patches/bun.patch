+/// 5 s rather than 1 s. Such a program (an interactive one) left waiting still collected every second for half a minute, the
+/// only thing that woke it (Pi at its prompt: 1.4 ms of CPU a second); at 5 s it gives the same memory back as soon, in a fifth
+/// of the wake-ups.
+fn default_fast_interval_ms() -> u64 {
+    #[cfg(target_os = "macos")]
+    {
+        unsafe extern "C" {
+            safe fn Bun__AOTImage__isMapped() -> bool;
+        }
+        if Bun__AOTImage__isMapped() {
+            return 5000;
+        }
+    }
+    1000
+}
+
+/// Quiet fast ticks before the timer drops to its slow interval: about half a minute, whatever the fast interval.
+fn quiet_ticks_until_slow(fast_interval_ms: i32) -> u8 {
+    (30_000 / fast_interval_ms.max(1000)).clamp(1, 30) as u8
+}
