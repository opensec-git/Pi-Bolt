diff --git a/scripts/build/download.ts b/scripts/build/download.ts
index 42d81846..daeca6fd 100644
--- a/scripts/build/download.ts
+++ b/scripts/build/download.ts
@@ -275,13 +275,39 @@ export async function extractTarGz(tarball: string, dest: string, stripComponent
     });
   }
   if (result.status !== 0) {
-    throw new BuildError(`tar extraction failed (exit ${result.status}): ${result.stderr}`, { file: tarball });
+    // Windows: making a symbolic link needs a privilege (or Developer Mode) that a build usually does not have, and bsdtar
+    // fails the whole extraction for it. Archives of sources have them among their tests (zstd's tests/cli-tests/bin): the
+    // archive is extracted again without them.
+    const links = process.platform === "win32" ? symbolicLinksIn(tarball) : [];
+    if (links.length === 0) {
+      throw new BuildError(`tar extraction failed (exit ${result.status}): ${result.stderr}`, { file: tarball });
+    }
+    const again = spawnSync(tarExe, [...args, ...links.flatMap(link => ["--exclude", link])], {
+      stdio: ["ignore", "ignore", "pipe"],
+      encoding: "utf8",
+    });
+    if (again.status !== 0) {
+      throw new BuildError(`tar extraction failed (exit ${again.status}): ${again.stderr}`, { file: tarball });
+    }
+    console.log(`left out ${links.length} symbolic link(s) of ${tarball}: ${links.join(", ")}`);
   }
 
   const entries = await readdir(dest);
   assert(entries.length > 0, `tar extracted nothing from ${tarball}`, { hint: "Tarball may be corrupt" });
 }
 
+/** The paths of the symbolic links in a .tar.gz, as `tar --exclude` takes them. */
+function symbolicLinksIn(tarball: string): string[] {
+  const listing = spawnSync(tarExe, ["-tvzf", tarball], { encoding: "utf8", maxBuffer: 1 << 28 });
+  if (listing.status !== 0) return [];
+  // bsdtar's long listing: the mode first ("lrwxr-xr-x"), the name last, then " -> target".
+  return listing.stdout
+    .split("\n")
+    .filter(line => line.startsWith("l"))
+    .map(line => line.split(" -> ")[0]!.split(/\s+/).pop()!)
+    .filter(Boolean);
+}
