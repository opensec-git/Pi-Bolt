new file mode 100644
index 0000000000..8af0fbf0ca
--- /dev/null
+++ b/patches/mimalloc/scavenger-idle-backoff.patch
@@ -0,0 +1,44 @@
+--- a/src/scavenger.c
++++ b/src/scavenger.c
+@@ -198,6 +198,10 @@
+   mi_subproc_t* const subproc = _mi_subproc_main();
+   mi_atomic_store_relaxed(&_mi_scavenger_thread_id, _mi_thread_id());
+   mi_msecs_t park_seen_last = 0;
++  // The safety net's wait when nothing is scheduled: doubles after each one that nothing interrupts, so a process left
++  // idle is not woken every 30 s for good (a pass over the arenas that finds nothing: 0.1-0.6 ms each, the only thing
++  // that still woke an idle Pi); back to 30 s as soon as anything wakes us or is scheduled.
++  mi_msecs_t idle_safety_ms = 30000;
+   while (mi_atomic_load_acquire(&_mi_scavenger_running) != 0) {
+     // Clear with an RMW, not a plain store: it must be totally ordered against the parker's
+     // coalescing `exchange(wake, 1)` in `_mi_scavenger_wake`. With a store, our clear and the later
+@@ -227,7 +231,7 @@
+       // Nothing scheduled: park until woken. The 30s bound is a pure safety
+       // net so stop() is guaranteed to take effect and any per-arena expiry
+       // that did not propagate to subproc is still eventually purged (below).
+-      timeout_ms = 30000;
++      timeout_ms = idle_safety_ms;
+     }
+     else {
+       const mi_msecs_t now = _mi_clock_now();
+@@ -260,11 +264,19 @@
+       continue;  // stopped polling: look once more for a thread that parked and did not wake us
+     }
+     if (mi_atomic_load_acquire(&_mi_scavenger_running) == 0) break;
++    const bool safety_wait = (expire == 0 && timeout_ms == idle_safety_ms);
+     mi_scav_wait(&subproc->scavenger_wake, timeout_ms);
+-    // The safety net: nothing was scheduled and nothing woke us. Look at the arenas all the same.
+-    if (expire == 0 && mi_atomic_load_relaxed(&subproc->scavenger_wake) == 0) {
++    const bool woken = (mi_atomic_load_relaxed(&subproc->scavenger_wake) != 0);
++    // The safety net: nothing was scheduled and nothing woke us. Look at the arenas all the same.
++    if (expire == 0 && !woken) {
+       _mi_arenas_try_purge(false /* force */, true /* visit_all */, subproc, 0 /* tseq */);
+     }
++    if (safety_wait && !woken) {
++      idle_safety_ms = (idle_safety_ms >= 1800000 ? 3600000 : 2*idle_safety_ms);
++    }
++    else if (woken || expire != 0) {
++      idle_safety_ms = 30000;
++    }
+   }
+ }
