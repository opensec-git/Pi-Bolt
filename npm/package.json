{
	"name": "pi-bolt",
	"version": "0.7.3",
	"description": "Pi, the coding agent, compiled ahead of time to native code: one executable for Linux x86-64, macOS on Apple silicon and Windows x64, starts 2-3x sooner than Pi on Bun and uses about a third of its CPU over a session",
	"keywords": [
		"pi",
		"coding-agent",
		"ai",
		"cli",
		"aot",
		"bun"
	],
	"homepage": "https://github.com/opensec-git/Pi-Bolt",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/opensec-git/Pi-Bolt.git",
		"directory": "npm"
	},
	"bugs": "https://github.com/opensec-git/Pi-Bolt/issues",
	"license": "MIT",
	"author": "OpenSec",
	"bin": {
		"pi-bolt": "bin/pi-bolt.exe"
	},
	"files": [
		"bin/pi-bolt",
		"bin/pi-bolt.exe",
		"install.cjs",
		"install.sh",
		"README.md"
	],
	"os": [
		"linux",
		"darwin",
		"win32"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"prepack": "node -e \"require('fs').copyFileSync('../install.sh', 'install.sh')\"",
		"postinstall": "node install.cjs"
	}
}
